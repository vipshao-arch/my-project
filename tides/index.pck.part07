render_mode unshaded, cull_disabled, depth_draw_never, shadows_disabled;
uniform float u_time = 0.0;
uniform bool preview = false;
varying vec3 world;
void vertex() {
	world=(MODEL_MATRIX*vec4(VERTEX,1.0)).xyz;
}
void fragment() {
	float height=UV.y;
	float drift=sin(world.x*.045+world.z*.029-u_time*.55)*sin(world.x*.012-world.z*.037+u_time*.24);
	float lace=0.66+0.34*drift;
	if (preview) {
		float dash=smoothstep(-.2,.25,sin((world.x+world.z)*.065));
		ALBEDO=vec3(.26,.94,.80);
		EMISSION=ALBEDO*.25;
		ALPHA=(1.0-height)*dash*.45;
	} else {
		float rim=1.0-smoothstep(.008,.035,height);
		ALBEDO=mix(vec3(.055,.028,.085),vec3(.72,.16,.09),rim);
		EMISSION=vec3(.68,.08,.035)*rim*.22;
		ALPHA=(1.0-smoothstep(.05,1.0,height))*lace*mix(.24,.70,rim);
	}
}
␀␀␀uniform bool u_raid_zone_enabled = false;
uniform sampler2D u_raid_zone_tex : filter_linear, repeat_disable;
uniform vec4 u_raid_zone_bounds = vec4(0.0, 0.0, 8000.0, 8000.0);
uniform float u_raid_zone_limit = 12000.0;
vec3 raid_zone_surface(vec3 water, vec2 world) {
	if (!u_raid_zone_enabled) return water;
	vec2 uv = (world - u_raid_zone_bounds.xy) / u_raid_zone_bounds.zw;
	if (any(lessThan(uv, vec2(0.0))) || any(greaterThan(uv, vec2(1.0)))) return water;
	vec2 size = vec2(textureSize(u_raid_zone_tex, 0));
	vec4 field = texture(u_raid_zone_tex, (uv * (size - 1.0) + 0.5) / size);
	if (field.g < 0.5) return water;
	float d = field.r / field.g * 12000.0;
	float edge = (1.0 - smoothstep(6.0, 28.0, abs(d - u_raid_zone_limit))) * 0.65;
	float danger = smoothstep(u_raid_zone_limit, u_raid_zone_limit + 180.0, d) * 0.48;
	return mix(mix(water, vec3(0.20, 0.075, 0.19), danger), vec3(0.95, 0.34, 0.15), edge);
}
