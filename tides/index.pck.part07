ï½ÞN–7J}ÈÀ¼Y‹t†s þþ␀␀␀␀␀␀␀␀␀␀␀shader_type spatial;
render_mode cull_disabled;
uniform sampler2D atlas_color : source_color;
uniform sampler2D shoreline_distance : filter_linear, repeat_disable;
uniform vec4 shoreline_bounds = vec4(0.0,0.0,32000.0,32000.0);
varying vec3 land_position;
varying vec3 land_normal;
float hash_land(vec2 p) {return fract(sin(dot(p,vec2(127.1,311.7)))*43758.5453);}
float noise_land(vec2 p) {
 vec2 i=floor(p), f=fract(p);f=f*f*(3.0-2.0*f);
 return mix(mix(hash_land(i),hash_land(i+vec2(1,0)),f.x),mix(hash_land(i+vec2(0,1)),hash_land(i+vec2(1,1)),f.x),f.y);
}
void vertex(){
 vec3 world=(MODEL_MATRIX*vec4(VERTEX,1)).xyz;
 float d=textureLod(shoreline_distance,(world.xz-shoreline_bounds.xy)/shoreline_bounds.zw,0.0).r;
 // Coast geometry and optical shore share the exact zero contour. Broad old
 // triangles cannot expose submerged land strips in water-wave troughs.
 if(d>0.0) VERTEX.y=min(VERTEX.y,-1.2-d*.06);
 land_position=(MODEL_MATRIX*vec4(VERTEX,1)).xyz;
 land_normal=normalize(MODEL_NORMAL_MATRIX*NORMAL);
}
void fragment(){
 vec2 p=land_position.xz;
 float detail=noise_land(p*.026)*.55+noise_land(p*.093)*.3+noise_land(p*.27)*.15;
 vec3 atlas=texture(atlas_color,p/32000.0).rgb;
 float coast=texture(shoreline_distance,(p-shoreline_bounds.xy)/shoreline_bounds.zw).r;
 if(coast>0.0) discard;
 float inland=max(-coast,0.0);
 float macro=noise_land(p*.0021+vec2(21.0,43.0));
 // Low plains inland are vegetated too. Altitude alone made all lowland white sand.
 vec3 sand=mix(vec3(.30,.255,.16),vec3(.46,.39,.25),detail);
 vec3 wet_sand=mix(vec3(.17,.18,.13),vec3(.25,.245,.17),detail);
 sand=mix(wet_sand,sand,smoothstep(-8.0,30.0,inland));
 vec3 soil=mix(vec3(.095,.19,.095),vec3(.23,.32,.14),detail);
 soil=mix(soil,clamp(atlas*.65,vec3(.075),vec3(.32)),.20);
 float slope=1.0-abs(normalize(land_normal).y);
 vec3 rock=mix(vec3(.32,.34,.33),vec3(.52,.52,.46),detail);
 float vegetated=smoothstep(65.0+macro*35.0,210.0+macro*110.0,inland);
 vec3 ground=mix(sand,soil,max(vegetated,smoothstep(20.0,65.0,land_position.y)));
 ground=mix(ground,rock,smoothstep(.20,.65,slope)*.8);
 float north=1.0-smoothstep(7800.0,12500.0,p.y);
 ground=mix(ground,vec3(.74,.83,.84)*(detail*.2+.8),north*smoothstep(20.0,90.0,land_position.y));
 ALBEDO=ground;ROUGHNESS=.94;SPECULAR=.18;
}
