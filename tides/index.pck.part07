render_mode unshaded, blend_mix, depth_draw_never, cull_disabled, shadows_disabled;
void fragment() {
	float radius = length((UV - 0.5) * 2.0);
	ALBEDO = vec3(0.12, 0.105, 0.075);
	ALPHA = (1.0 - smoothstep(0.0, 1.0, radius)) * 0.20;
}
