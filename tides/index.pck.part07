  "growth_formulas": {
    "equipment_e": ".5*(level-1)/9 + .3*enhance/10 + .2*(quality-1)/3",
    "pvp_hull": "H*(1+.03*x_ship+.02*part_hull/5+.02*e_ship_armor+.01*e_hero_armor)",
    "pvp_GW": "1+.05*x_ship+.10*e_ship_weapon",
    "pvp_GH": "1+.04*x_hero+.06*(active_rank-1)/4+.05*e_hero_weapon",
    "pvp_GP": "1+.04*x_hero+.06*(passive_rank-1)/4+.05*e_hero_weapon",
    "pvp_GT": "1+.05*x_ship+.10*(tactical_rank-1)/4",
    "pve_hull": "H*(1+.03*(ship_level-1)+.04*part_hull+.18*e_ship_armor+.08*e_hero_armor)",
    "pve_GW": "1+.02*(ship_level-1)+.40*e_ship_weapon",
    "pve_GH": "1+.02*(hero_level-1)+.05*(active_rank-1)+.20*e_hero_weapon",
    "pve_GP": "1+.02*(hero_level-1)+.05*(passive_rank-1)+.20*e_hero_weapon",
    "pve_GT": "1+.02*(ship_level-1)+.05*(tactical_rank-1)",
