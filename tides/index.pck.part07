render_mode unshaded, cull_disabled, depth_draw_never, blend_mix, shadows_disabled;

uniform sampler2D u_tex : filter_linear_mipmap, repeat_disable;
uniform vec4 u_color : source_color = vec4(1.0);
uniform float u_opacity = 1.0;
uniform float u_rotation = 0.0;
uniform float u_luma_alpha = 0.0;
uniform float u_time = 0.0;
uniform float u_wave_height = 1.0;
uniform float u_wave_dir = 0.0;
uniform float u_rough = 0.0;
uniform sampler2DArray u_coast_tex : filter_linear, repeat_disable;
uniform vec4 u_coast_bounds[32];
uniform int u_coast_n = 0;
varying vec2 v_surface_position;

#include "res://td3d/ocean_waves.gdshaderinc"

float surface_shore(vec2 p) {
	float distance = 10000.0;
	for (int i = 0; i < 32; i++) {
		if (i >= u_coast_n) break;
		vec4 bounds = u_coast_bounds[i];
		vec2 uv = (p - bounds.xy) / bounds.zw;
		if (min(uv.x, uv.y) >= 0.0 && max(uv.x, uv.y) <= 1.0)
			distance = min(distance, textureLod(u_coast_tex, vec3(uv, float(i)), 0.0).r);
	}
	return distance;
}

void vertex() {
	vec4 world = MODEL_MATRIX * vec4(VERTEX, 1.0);
	vec2 slope;
	world.y = ocean_height(world.xz, u_time, slope)
		* smoothstep(0.0, 38.0, surface_shore(world.xz)) + 0.08;
	v_surface_position = world.xz;
	POSITION = PROJECTION_MATRIX * VIEW_MATRIX * world;
}

void fragment() {
	if (surface_shore(v_surface_position) < -0.5) discard;
	vec2 local = UV - 0.5;
	float c = cos(u_rotation);
	float s = sin(u_rotation);
	local = vec2(local.x * c - local.y * s, local.x * s + local.y * c) + 0.5;
	vec4 texel = texture(u_tex, local);
	float luma = dot(texel.rgb, vec3(0.2126, 0.7152, 0.0722));
	float tex_alpha = mix(texel.a, texel.a * smoothstep(0.025, 0.30, luma), u_luma_alpha);
	float radial = 1.0 - smoothstep(0.46, 0.68, length(local - 0.5));
	tex_alpha *= mix(1.0, radial, u_luma_alpha);
	float alpha = tex_alpha * u_opacity * u_color.a;
	if (alpha < 0.004) discard;
	ALBEDO = texel.rgb * u_color.rgb;
	ALPHA = alpha;
}
shader_type spatial;
render_mode unshaded, cull_disabled, depth_draw_never, blend_mix, shadows_disabled;

uniform sampler2D u_tex : filter_linear, repeat_enable;
uniform vec4 u_color : source_color = vec4(0.88,0.96,1.0,1.0);
uniform float u_opacity = 1.0;

varying vec4 v_color;

void vertex() {
	v_color = COLOR;
}

void fragment() {
	vec4 texel = texture(u_tex, UV);
	float alpha = texel.a * v_color.a * u_opacity * u_color.a;
	if (alpha < 0.015) discard;
	ALBEDO = texel.rgb * u_color.rgb;
	ALPHA = alpha;
}
␀shader_type spatial;
render_mode unshaded, cull_disabled, depth_draw_never, blend_add, shadows_disabled;

uniform vec4 u_color : source_color = vec4(0.7, 0.9, 1.0, 0.8);
uniform float u_opacity : hint_range(0.0, 1.0) = 0.8;
uniform float u_time = 0.0;
uniform sampler2D u_noise : filter_linear, repeat_enable;

void fragment() {
	float across = abs(UV.y - 0.5) * 2.0;
	float outer = 1.0 - smoothstep(0.58, 1.0, across);
	float core = 1.0 - smoothstep(0.0, 0.22, across);
	float scroll = texture(u_noise, vec2(UV.x * 3.2 - u_time * 1.8, UV.y)).r;
	float flow = 0.82 + 0.18 * sin(UV.x * 42.0 - u_time * 30.0 + scroll * 7.0);
	ALBEDO = u_color.rgb * (0.78 + core * 1.15);
	ALPHA = u_color.a * u_opacity * outer * flow * (0.62 + core * 0.38);
}
␀␀␀␀␀␀␀␀␀␀␀shader_type spatial;
render_mode unshaded, cull_disabled, depth_draw_never, blend_mix, shadows_disabled;

uniform vec4 u_color : source_color = vec4(1.0, 0.70, 0.22, 1.0);
uniform float u_opacity = 1.0;
uniform float u_rotation = 0.25;

void vertex() {
	MODELVIEW_MATRIX = VIEW_MATRIX * mat4(
		vec4(INV_VIEW_MATRIX[0].xyz, 0.0),
		vec4(INV_VIEW_MATRIX[1].xyz, 0.0),
		vec4(INV_VIEW_MATRIX[2].xyz, 0.0),
		vec4(MODEL_MATRIX[3].xyz, 1.0)
	);
	MODELVIEW_MATRIX = MODELVIEW_MATRIX * mat4(
		vec4(length(MODEL_MATRIX[0].xyz), 0.0, 0.0, 0.0),
		vec4(0.0, length(MODEL_MATRIX[1].xyz), 0.0, 0.0),
		vec4(0.0, 0.0, length(MODEL_MATRIX[2].xyz), 0.0),
		vec4(0.0, 0.0, 0.0, 1.0)
	);
}

void fragment() {
	vec2 uv = UV - 0.5;
	float c = cos(u_rotation);
	float s = sin(u_rotation);
	uv = vec2(uv.x * c - uv.y * s, uv.x * s + uv.y * c) + 0.5;
	vec2 p = (uv - 0.5) * vec2(0.74, 1.08);
	float corner = min(min(p.x + 0.34, 0.34 - p.x), min(p.y + 0.50, 0.50 - p.y));
	float body = smoothstep(-0.018, 0.006, corner);
	float border = body * (1.0 - smoothstep(0.018, 0.045, corner));
	float diamond = body * (1.0 - smoothstep(0.17, 0.24, abs(p.x) + abs(p.y) * 0.66));
	float inner = body * (1.0 - smoothstep(0.030, 0.040, corner + 0.06));
	vec3 navy = vec3(0.030, 0.055, 0.085);
	vec3 gold = u_color.rgb;
	ALBEDO = mix(navy, gold, clamp(border * 1.2 + diamond * 0.82, 0.0, 1.0));
	EMISSION = gold * (0.40 + border * 1.1 + diamond * 0.7);
	ALPHA = body * u_opacity * u_color.a;
}
␀␀␀␀␀␀␀␀␀␀␀␀shader_type spatial;
render_mode unshaded, cull_back, depth_draw_never, blend_add, shadows_disabled;

uniform vec4 u_color : source_color = vec4(0.22, 0.82, 1.0, 0.34);
uniform sampler2D u_rune_tex : filter_linear_mipmap, repeat_enable;

void fragment() {
	vec3 n = normalize(NORMAL);
	vec3 v = normalize(VIEW);
	float fresnel = pow(1.0 - clamp(abs(dot(n, v)), 0.0, 1.0), 2.2);
	vec2 uv = UV * vec2(4.0, 2.4) + vec2(TIME * 0.018, -TIME * 0.026);
	float runes = texture(u_rune_tex, uv).a;
	float bands = 0.5 + 0.5 * sin((UV.y * 18.0) - TIME * 0.9 + UV.x * 4.0);
	bands = smoothstep(0.72, 0.98, bands);
	float rim = smoothstep(0.22, 0.52, fresnel);
	ALBEDO = u_color.rgb * (0.45 + bands * 0.75);
	EMISSION = u_color.rgb * (rim * 0.95 + runes * 0.24 + bands * 0.10);
	ALPHA = u_color.a * (rim * 1.35 + bands * 0.11 + runes * 0.17);
}
