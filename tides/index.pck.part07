Ý™‡¤,zÑb¢üe¶½‹îÿoEqÑ-*—Ã‹Ï×Ù˜ä'9þ}2¹îó{ r?dô³V‡³~ÍQŽ9’z™ýgowæamºÍ‰x=ìA—;ç,é‡V<eoÉžÕý`âÍŠ—"“A»ðÌÇû´²yïT,a/A`ô¤ßÿK Ôî*¼ºI\MÆŠ§¡í®Í‡“!Y„ÿë‡þôºqÌ^ìµ· úùü`w´3»wwwêx¢BnæïõAºÔ_àYê5¯"º.sþÎeœW®ÏëôJÍè®ê6èu␀ŸlìÑzÕÕ1?¸o«Ü¿xCŸì-Ãý_uÓ¬Of¯ ÙÁ°b¶Ux&-»‹Ø·c…ü’\GüG÷u¤÷ÓæžïoµIÔ/X7ÀÛi‡oö^‚:Ö•¡²+jÈ:ÄV~ÃYì/,Tv3zÏuÆø3íéß9ÙO°Ï”S×êß½ôïÞÇÏs|3Ž9ê·c÷þô“„î@èjœýÎ¹£š¿è¶÷˜÷? ß␀ºjnã©cÝ¹êÇukÞê7•}UÕ•u+^;<ÔÑ;fUéîúdÁÇóÇÛÚXø-ÛÒüDÓ3·æVÌ…À†âöÜœçSëåÎé?šÑoíØéÚö@ÍÂé‡Œ†Û]ÓN¯²_ó{Î¾é°Cê'MÌïø'}f~ˆÏíB|•ð&üýé”þ\ñãúO€ïâÝy<´@o1bs¾»žŽÙÖô‘¡›±÷Åßáe¿ãö~ü3üøðÿÒý¦MÍZéz§àŽÌ¤ßI}ÀÙöÒ"Ÿû0«÷ÅGÿ-âënöÃÈYuž'dcvGâì~ýðH|ç…£	üX&}aöxý'îÌÞ¹…\␀½¨egèâÝÚt␀␀␀␀␀␀␀␀␀␀␀␀␀// One world-space cloud field shared by the sky and receiving materials.
global uniform float env_cloud_coverage;
global uniform vec2 env_cloud_offset;
global uniform vec3 env_cloud_light_dir;
global uniform float env_cloud_shadow_strength;
uniform sampler2D u_cloud_noise_tex : filter_linear_mipmap, repeat_enable;

float cloud_density_filtered(vec2 world_xz, float lod) {
	vec2 p = (world_xz - env_cloud_offset) * 0.000047;
	// Filter over the ray's footprint, including the integration step length.
	float broad = textureLod(u_cloud_noise_tex, p, lod).r;
	float detail = textureLod(u_cloud_noise_tex, p * 2.71 + vec2(0.31, 0.67), lod + 1.44).r;
	float n = broad * 0.78 + detail * 0.22;
	float threshold = mix(0.75, 0.24, env_cloud_coverage);
	return smoothstep(threshold - 0.16, threshold + 0.23, n);
}
float cloud_density(vec2 world_xz) {
	return cloud_density_filtered(world_xz, 0.0);
}
float cloud_transmittance(vec3 world_p) {
	vec2 projected = world_p.xz + env_cloud_light_dir.xz
		* max(1800.0 - world_p.y, 0.0) / max(env_cloud_light_dir.y, 0.15);
	return 1.0 - cloud_density(projected) * env_cloud_shadow_strength;
}
