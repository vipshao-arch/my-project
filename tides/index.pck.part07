6>ÛÈƒC‰>KZù/»øßÜ¨Î#fìŠN¥±hg¯Ÿò\CÙ¸Õ¿ÃÃÅªšNý5’+Œµ.Y˜Â,û7ªŸÂ±´Tª²ÿÊÓñ·*ObÒA;u ³²w␀\£EžºYNØ5‰P]#c­.ÉY©bâA␀␀␀␀␀␀shader_type spatial;
render_mode blend_mix, depth_draw_never, cull_disabled, unshaded, shadows_disabled, ambient_light_disabled;

uniform sampler2D u_tex : source_color;
uniform vec4 u_col : source_color = vec4(1.0, 0.98, 0.92, 1.0);

void fragment() {
	vec4 c = texture(u_tex, UV);
	ALBEDO = c.rgb * u_col.rgb;
	ALPHA = c.a * u_col.a;
}
␀␀␀␀␀␀␀␀␀␀␀␀␀␀// Fragment-only capillary field. A sum of a dozen plane waves reads as
// parallel stripes once the camera is close to the water; this uses rotated,
// anisotropic value-noise octaves instead. Each octave has its own irrational
// scale and rotation, so there is no fixed tile or repeating crest interval.
vec2 od_hash2(vec2 i) {
	float a = fract(sin(dot(i, vec2(127.1, 311.7)) + 17.73) * 43758.5453);
	float b = fract(sin(dot(i, vec2(269.5, 183.3)) + 31.17) * 43758.5453);
	return vec2(a, b) * 2.0 - 1.0;
}

// Perlin gradient noise. Value-noise cells projected the lattice into the
// grazing-angle view as large square patches; gradient noise keeps the fine
// wave field isotropic while the analytic derivative drives the normal.
float od_noise(vec2 p, out vec2 grad) {
	vec2 i = floor(p);
	vec2 f = fract(p);
	vec2 u = f * f * f * (f * (f * 6.0 - 15.0) + 10.0);
	vec2 du = 30.0 * f * f * (f * (f - 2.0) + 1.0);
	vec2 ga = od_hash2(i);
	vec2 gb = od_hash2(i + vec2(1.0, 0.0));
	vec2 gc = od_hash2(i + vec2(0.0, 1.0));
	vec2 gd = od_hash2(i + vec2(1.0, 1.0));
	float va = dot(ga, f);
	float vb = dot(gb, f - vec2(1.0, 0.0));
	float vc = dot(gc, f - vec2(0.0, 1.0));
	float vd = dot(gd, f - vec2(1.0, 1.0));
	float value = mix(mix(va, vb, u.x), mix(vc, vd, u.x), u.y);
	float dx = mix(mix(ga.x, gb.x, u.x), mix(gc.x, gd.x, u.x), u.y)
		+ mix(vb - va, vd - vc, u.y) * du.x;
	float dy = mix(mix(ga.y, gb.y, u.x), mix(gc.y, gd.y, u.x), u.y)
		+ mix(vc - va, vd - vb, u.x) * du.y;
	grad = vec2(dx, dy);
	return value;
}

// Two-octave sub-metre pore field for whitecap lace. It is evaluated only for
// foam coverage, so the rest of the sea does not pay for extra noise octaves.
float ocean_pore_noise(vec2 p) {
	vec2 g;
	vec2 q = p * 1.90 + vec2(7.3, -3.1);
	float a = od_noise(q, g);
	q = mat2(vec2(0.42, 0.91), vec2(-0.91, 0.42)) * q * 2.07 + vec2(19.1, 5.7);
	float b = od_noise(q, g);
	// Normalize the zero-mean gradient field before applying coverage thresholds.
	return clamp(0.5 + (a * 0.68 + b * 0.32) * 0.85, 0.0, 1.0);
}

vec2 ocean_micro_slope(vec2 p, float t, float pixel, float rough, float detail) {
	// Keep noise coordinates tied to the generated spectrum, not changing wind.
	// Rotating world positions by wind reprojects kilometres of detail each tick.
	vec2 wind = vec2(sin(u_wave_dir), cos(u_wave_dir));
	vec2 side = vec2(-wind.y, wind.x);
	// Wind-aligned anisotropy makes short wavelets longer along the wind.
	// This is what separates a wind-driven sea from an isotropic noise sheet.
	vec2 q = vec2(dot(p, wind) * 0.85, dot(p, side) * 1.15);
	q += vec2(t * 0.024, -t * 0.009);
	mat2 rot0 = mat2(vec2(0.80, 0.60), vec2(-0.60, 0.80));
	mat2 rot1 = mat2(vec2(0.36, -0.93), vec2(0.93, 0.36));
	mat2 rot2 = mat2(vec2(-0.71, 0.70), vec2(-0.70, -0.71));
	vec2 slope = vec2(0.0);
	float scale = 0.14;
	float amplitude = 0.82;
	// Three octaves cover roughly 7 m down to 1.7 m. The per-octave footprint
	// test removes bands the screen cannot resolve without using one global
	// mip level for the whole surface.
	for (int i = 0; i < 3; i++) {
		mat2 r = rot0;
		if (i == 1) r = rot1;
		if (i == 2) r = rot2;
		vec2 gp;
		vec2 local = r * q * scale + vec2(13.1, -7.7) * float(i + 1)
			+ vec2(t * 0.009, -t * 0.006) * float(i + 1);
		od_noise(local, gp);
		vec2 world_grad = transpose(r) * gp * scale;
		float footprint = 1.0 / max(scale, 0.0001);
		float band = 1.0 - smoothstep(footprint * 0.10, footprint * 0.38,
			pixel * 2.2);
		slope += world_grad * amplitude * band;
		scale *= 2.07;
		amplitude *= 0.54;
	}
	// Convert the wind-aligned gradient back to world axes.
	vec2 world_slope = wind * (slope.x * 0.85) + side * (slope.y * 1.15);
	// Broad gust patches vary the capillary roughness without a visible tile.
	float gust = 0.72 + 0.20 * sin(dot(p, vec2(0.0047, 0.0031)) + t * 0.021)
		+ 0.08 * sin(dot(p, vec2(-0.0029, 0.0053)) - t * 0.017 + 1.9);
	return world_slope * detail * gust * (0.62 + rough * 0.90);
}

// World gradient of a screen-sampled scalar (coast / distance attenuation).
vec2 ocean_screen_gradient(float value, vec2 p) {
	vec2 dx = dFdx(p);
	vec2 dy = dFdy(p);
	float determinant = dx.x * dy.y - dx.y * dy.x;
	if (abs(determinant) < 0.000001) return vec2(0.0);
	return vec2(dFdx(value) * dy.y - dFdy(value) * dx.y,
		dFdy(value) * dx.x - dFdx(value) * dy.x) / determinant;
}
␀␀␀␀␀␀␀␀␀␀␀␀␀// Naval Battle Kit's foam separates coverage from multi-channel erosion.
// The source mask packs micro distance / noise / pores / macro distance.
// Texture is data (no source_color); opacity remains on the one sea surface.
vec4 ocean_foam_mask(vec2 p, float t) {
	vec2 drift = vec2(t * 0.012, -t * 0.008);
	vec2 q = p + drift + vec2(sin(p.y * 0.009), sin(p.x * 0.013)) * 2.0;
	vec4 a = texture(u_foam_mask_tex, q * 0.11);
	vec2 r = vec2(q.x * 0.80 + q.y * 0.60, -q.x * 0.60 + q.y * 0.80);
	vec4 b = texture(u_foam_mask_tex, r * 0.0737 + vec2(0.31, 0.57));
	return mix(a, b, 0.28);
}

float ocean_foam_erosion(float coverage, vec4 mask) {
	float erosion = pow(1.0 - clamp(coverage, 0.0, 1.0) * 0.65, 4.0);
	erosion += (1.0 - mask.r * 2.0) * mix(0.05, 0.60, erosion);
	erosion -= (mask.g * 2.0 - 1.0) * mix(0.10, 0.20, erosion);
	erosion = clamp(erosion * 2.2, 0.0, 0.995);
	float edge = clamp((mask.a - erosion) / max(1.0 - erosion, 0.005)
		* mix(5.0, 0.10, erosion), 0.0, 1.0);
	float pores = (1.0 - mix(mask.a, mask.r, 0.5) * 0.45) * pow(max(mask.b, 0.001), 0.3);
	float remaining = edge * pores * pow(1.0 - erosion, 2.0);
	return clamp(remaining + pow(coverage * 0.80, 5.0), 0.0, 1.0);
}
