úkáüÅJÞ›‰ð*ÆÃ¿±³Ü®ë£¾âô¹|7NÈºç(Áù1ËøëL€µˆ~ð×p¾j9Pé
s(k0~G8ïAŽ?s>›¡ÇŠí¼Jòr˜eØ0ôÆ¾ðËåwö:•	ðÎy>k'DgÑ{Ò¯¹Ï[p-\LÎýÃÙYðZŽý¿€~:z„ñs•Zñwçá´{Nk9i_Êü;Œ1æ\«{Ö_¾§­–© Ã±åîŸÚpöh-¨>hæeøøå/œêo[Œ,ï5çµXð¸è¼¯µf”dÐeŸ|ah}}k“¡è”ûAçÂ^ƒð:ÏK)WŸ3ej‹“Là?‚œ®Â®ÑýÈ%&:RóZ€ ‡ñ‘½Û{plèÎÄñïrà<vüfÑDã[ÿ)uˆ¶9‚|Äb‘ß\~// Shared, bounded phase warp: the local wave direction bends gradually without
// multiplying a position-dependent rotation by large world coordinates.
float ocean_sample(vec2 p, float t, out vec2 gradient, out vec4 breaking) {
	vec2 w = p + vec2(
		sin(p.y * 0.0015 + t * 0.025) * 42.0 + sin(p.y * 0.0041 - t * 0.040 + 1.7) * 12.0,
		sin(p.x * 0.0013 - t * 0.023 + 0.8) * 42.0 + sin(p.x * 0.0037 + t * 0.037 + 2.3) * 12.0);
	float wz_dx = cos(p.x * 0.0013 - t * 0.023 + 0.8) * 0.0546
		+ cos(p.x * 0.0037 + t * 0.037 + 2.3) * 0.0444;
	float wx_dz = cos(p.y * 0.0015 + t * 0.025) * 0.063
		+ cos(p.y * 0.0041 - t * 0.040 + 1.7) * 0.0492;
	float ca = cos(u_wave_dir);
	float sa = sin(u_wave_dir);
	vec2 dirs[7] = { vec2(0.860, 0.510), vec2(-0.420, 0.910), vec2(0.660, -0.750),
		vec2(0.95, 0.31), vec2(0.38, 0.925), vec2(-0.72, 0.694), vec2(0.99, -0.141) };
	float wavelengths[7] = {300.0, 190.0, 120.0, 73.0, 47.0, 31.0, 19.0};
	float amplitudes[7] = {1.60, 1.12, 0.82, 0.46, 0.30, 0.18, 0.090};
	float speeds[7] = {0.38, -0.31, 0.24, 0.51, -0.58, 0.69, -0.80};
	float height = 0.0;
	vec2 g = vec2(0.0);
	breaking = vec4(0.0);
	float sharp = mix(0.22, 0.38, u_rough);
	for (int i = 0; i < 7; i++) {
		vec2 d = vec2(dirs[i].x * ca - dirs[i].y * sa, dirs[i].x * sa + dirs[i].y * ca);
		float k = 6.2831853 / wavelengths[i];
		float phase = dot(d, w) * k + t * speeds[i];
		vec2 phase_gradient = d * k;
		if (i >= 3) {
			// Bounded along-crest bending makes wind waves meander instead
			// of exposing parallel rails in the high camera. Keep its full
			// derivative and mirror the same phase in CPU buoyancy.
			vec2 across = vec2(-d.y, d.x);
			float side = dot(w, across);
			float bend0 = side * 0.027 + t * 0.045 + float(i) * 1.3;
			float bend1 = side * 0.059 - t * 0.033 + float(i) * 0.9;
			phase += sin(bend0) * 0.85 + sin(bend1) * 0.35;
			phase_gradient += across * (cos(bend0) * 0.02295 + cos(bend1) * 0.02065);
		}
		float s = sin(phase);
		float amplitude = amplitudes[i] * (i >= 3 ? mix(1.0, 1.30, u_rough) : 1.0);
		// Sharper positive crests and flatter troughs, with zero mean height.
		height += amplitude * (s + sharp * (s * s - 0.5) + 0.08 * sin(phase * 2.0));
		g += vec2(phase_gradient.x + phase_gradient.y * wz_dx,
			phase_gradient.y + phase_gradient.x * wx_dz) * amplitudes[i]
			* (i >= 3 ? mix(1.0, 1.30, u_rough) : 1.0)
			* (cos(phase) * (1.0 + 2.0 * sharp * s) + 0.16 * cos(phase * 2.0));
		// Keep the four wind-wave crest coordinates. Fragment erosion gives
		// shorter waves smaller, fainter fragments rather than white rails.
		// Long swell never becomes a white foam sheet.
		if (i >= 3) breaking[i - 3] = s;
	}
	float p0 = w.x * 0.0016 + w.y * 0.0012 + t * 0.034;
	float p1 = w.y * 0.0030 - w.x * 0.0011 - t * 0.027 + 1.3;
	float m = 0.82 + 0.11 * sin(p0) + 0.07 * sin(p1);
	vec2 mg = 0.11 * cos(p0) * vec2(0.0016 + 0.0012 * wz_dx, 0.0012 + 0.0016 * wx_dz)
		+ 0.07 * cos(p1) * vec2(-0.0011 + 0.0030 * wz_dx, 0.0030 - 0.0011 * wx_dz);
	float scale_factor = u_wave_height * (1.0 + u_rough * 0.35);
	gradient = (g * m + height * mg) * scale_factor;
	return height * m * scale_factor;
}

float ocean_height(vec2 p, float t, out vec2 gradient) {
	vec4 breaking;
	return ocean_sample(p, t, gradient, breaking);
}
