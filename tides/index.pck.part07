NºÍÈ{ùä+S!ï;^ájXy@öþ¶a_ÀÖ³íøâã¬¿ˆÿÇx+çFc³{¾iV“\?R“…­¥7Œ9Éy^«ðpY¯Ìðv‹áe¯ev+°^ýƒUcˆõ¸:n%ÏŸÆÓ¾ÄöÝ–Q>`Ÿ£Ïã†Šßò’o¼—÷šî©<Ó£Ì;œ–1yoß‘ÒT¾®>èzô5ý71{û(øš~&ï]?ëmüê³ÝïÕ{êÏ¶	õþ°å¬ùXNù[¥ÀÖ|úé®_e#í=®äÃ‹™9ÖÅyÌ;?PN-Ï2ìúFºØ½¯ŽÏQÛ-y¦9«õ¹žEÿ9nê¶¹Û{œ¯:Ú}¦ýkõ®5OãÉÔÇ:´®¿ÒóñÚ”¾Õ>ÕêmÖ’ú©Öéç-l¢.Ä³¼v0‹_	žïÑáqÎw×Áù8±T±œÐexBwù$
Ü¯ìUyFŽJãõº“í`Ÿ+çæu‹viž5=à[Î¤âj|ãñÓäE^êœçç¼ÿDþ\‘–:£^_„	ü‚c–òï²¡žî”—:ÿê]t³7”Aì#£ŸX–ë/¨/4gð
^‹c¸±Çy/´ï·‡÷e„úÀË­ï:×ñ19Ü¾ïÃ!áï€]îZ½ŒŸ8TþšL+ÃÖúø6ï”Ô¬6ÇHèÀ$×Æ÷<WVcd|·,O¾Nzãëø¢ÿûKŽï˜-ðÓ§íúNÝS¼ŒP|Â üzÃñ>výðÎÿe†êâŸï>›ïë¶dŒaÝ␀␀// Bounded local water-scattering fill driven by the actual vessel night rig.
// Evaluated on the displaced sea, with no projected disk or second surface.
uniform vec4 u_vessel_lights[8]; // xz, soft radius, normalized night-light energy
uniform float u_vessel_fill_strength = 1.0;

vec3 vessel_water_fill(vec2 p, vec3 surface_normal) {
	vec3 radiance = vec3(0.0);
	for (int i = 0; i < 8; i++) {
		if (i >= u_ship_n) break;
		vec4 lamp = u_vessel_lights[i];
		if (lamp.w < 0.001 || lamp.z < 1.0) continue;
		vec2 rel = p - lamp.xy;
		if (max(abs(rel.x), abs(rel.y)) > lamp.z) continue;
		float r2 = dot(rel, rel) / (lamp.z * lamp.z);
		float pool = exp(-r2 * 3.4) * (1.0 - smoothstep(0.55, 1.0, r2));
		// Crest/trough normals retain local detail inside the soft light pool.
		float scatter = 0.55 + 0.45 * clamp(surface_normal.y, 0.0, 1.0);
		radiance += vec3(0.012, 0.038, 0.062) * pool * scatter * lamp.w;
	}
	return min(radiance, vec3(0.028, 0.074, 0.118)) * u_vessel_fill_strength;
}
␀␀␀shader_type spatial;
render_mode blend_mix, depth_draw_never, cull_disabled, unshaded, shadows_disabled, ambient_light_disabled;

uniform vec3 u_col : source_color = vec3(0.92, 0.98, 1.00);
uniform float u_time = 0.0;

varying vec2 v_uv;

void fragment() {
	vec2 uv = v_uv;
	float al = clamp(uv.y, 0.0, 1.0);
	float ax = abs(uv.x * 2.0 - 1.0);
	// ä¸¤æ¡å‘å¤–å¼ å¼€çš„å°¾è¿¹è‡‚
	float arm = 0.10 + al * 0.62;
	float aw = 0.035 + al * 0.085;
	float arms = exp(-pow((ax - arm) / aw, 2.0));
	// èˆ¹æ­£åŽæ–¹çš„æ…åŠ¨æ°´
	float core = exp(-pow(ax / (0.055 + al * 0.16), 2.0)) * (1.0 - al * 0.75);
	// ç»†ç¢Žæ³¡æ²«æ¡çº¹
	float st = 0.55 + 0.45 * sin(al * 22.0 - u_time * 2.6 + ax * 6.0);
	float a = (arms * 0.62 + core * 0.85) * st;
	a *= pow(1.0 - al, 1.05);
	a *= 1.0 - smoothstep(0.88, 1.0, ax);
	ALBEDO = u_col;
	ALPHA = clamp(a, 0.0, 1.0) * 0.80;
}␀␀␀␀␀␀␀␀␀␀␀␀␀␀shader_type spatial;
render_mode blend_mix, depth_draw_never, cull_disabled, unshaded, shadows_disabled, ambient_light_disabled;

uniform vec3 u_col : source_color = vec3(0.84, 0.92, 1.0);
uniform float u_time = 0.0;

void fragment() {
	vec2 uv = UV;
	float ax = abs(uv.x * 2.0 - 1.0);
	float edge = 1.0 - smoothstep(0.30, 1.0, ax);
	float a = clamp(uv.y, 0.0, 1.0);
	float fade = pow(a, 1.6);
	float n = 0.60 + 0.40 * sin(a * 37.0 + ax * 15.0 - u_time * 2.6)
		* sin(a * 11.0 - ax * 8.0 + u_time * 1.5);
	ALBEDO = u_col;
	ALPHA = clamp(edge * fade * n * 0.48, 0.0, 1.0);
}
␀␀shader_type spatial;
render_mode depth_draw_opaque, cull_back, diffuse_burley, specular_schlick_ggx;

uniform float u_time = 0.0;
#include "res://td3d/raid/zone_surface.gdshaderinc"
uniform float u_tide = 0.0;
uniform float u_wave_height = 1.0;
uniform float u_wave_dir = 0.0;
uniform float u_near_swell = 0.18;
uniform float u_crest_glow = 1.25;
uniform float u_foam_strength = 1.0;
uniform float u_foam_opacity = 0.68;
uniform float u_clarity = 1.25;
uniform float u_shallow_width = 1.20;
uniform float u_rough = 0.0;
uniform float u_night = 0.0;
uniform float u_fog_den = 1.0;
uniform float u_rain = 0.0;
uniform float u_flash = 0.0;
uniform vec3 u_air_color : source_color = vec3(0.47, 0.61, 0.72);
uniform float u_air_density = 0.00022;
uniform sampler2D u_screen : hint_screen_texture, filter_linear_mipmap, repeat_disable;
uniform sampler2D u_depth : hint_depth_texture, filter_nearest, repeat_disable;
uniform vec2 u_wind = vec2(0.0, 1.0);
uniform vec3 u_deep : source_color = vec3(0.035, 0.235, 0.39);
uniform vec3 u_shallow : source_color = vec3(0.075, 0.49, 0.47);
uniform vec3 u_foam : source_color = vec3(0.94, 0.98, 1.0);
uniform vec3 u_sky_top : source_color = vec3(0.05, 0.19, 0.44);
uniform vec3 u_sky_hor : source_color = vec3(0.55, 0.74, 0.85);
uniform vec3 u_skyc : source_color = vec3(0.58, 0.74, 0.86);
uniform vec3 u_sun_dir = vec3(0.35, 0.55, 0.75);
uniform vec3 u_moon_dir = vec3(0.0, 0.30, -0.95);
uniform vec3 u_sun_col : source_color = vec3(1.0, 0.95, 0.85);
uniform vec3 u_fogc : source_color = vec3(0.55, 0.68, 0.80);
uniform vec3 u_tint : source_color = vec3(1.0);
uniform sampler2D u_norm_tex : filter_linear_mipmap, repeat_enable;
uniform sampler2D u_foam_tex : filter_linear_mipmap, repeat_enable;
uniform sampler2D u_caustics_tex : filter_linear_mipmap, repeat_enable;
uniform sampler2DArray u_coast_tex : filter_linear, repeat_disable;
uniform vec4 u_coast_bounds[32];
uniform int u_coast_n = 0;
uniform vec4 u_ships[8];
uniform vec4 u_shipd[8];
uniform vec4 u_hull_profiles[16];
uniform int u_ship_n = 0;
uniform vec4 u_wakes[64];
uniform vec4 u_wakedirs[64];
uniform int u_wake_n = 0;
uniform vec4 u_impact_outline[32];
uniform vec4 u_impact_points[32];
uniform int u_impact_n = 0;
uniform int u_impact_point_n = 0;
uniform float u_impact_ready = 1.0;
uniform vec4 u_impact_burst = vec4(0.0);

varying vec3 v_wp;
varying vec3 v_world;

#include "res://td3d/cloud_field.gdshaderinc"

#include "res://td3d/ocean_waves.gdshaderinc"
#include "res://td3d/environment/wind_field.gdshaderinc"
#include "res://td3d/sea_surface_detail.gdshaderinc"

float hash21(vec2 p) {
	// Avoid large-coordinate sin precision loss (square patches offshore).
	vec3 q = fract(vec3(p.xyx) * 0.1031);
	q += dot(q, q.yzx + 33.33);
	return fract((q.x + q.y) * q.z);
}

float noise2(vec2 p) {
	vec2 i = floor(p);
	vec2 f = fract(p);
	f = f * f * (3.0 - 2.0 * f);
	return mix(mix(hash21(i), hash21(i + vec2(1.0, 0.0)), f.x),
		mix(hash21(i + vec2(0.0, 1.0)), hash21(i + vec2(1.0)), f.x), f.y);
}

float foam_noise(vec2 p) {
	// Mip-filtered seamless simplex field. Thresholded value-noise cells
	// formed square patches at crests; two rotated scales hide tile repeats.
	vec2 q = p * 0.11;
	vec2 rotated = vec2(q.x * 0.79 - q.y * 0.61, q.x * 0.61 + q.y * 0.79);
	return texture(u_cloud_noise_tex, q + vec2(0.37, 0.19)).r * 0.64
		+ texture(u_cloud_noise_tex, rotated * 1.73 + vec2(0.71, 0.43)).r * 0.36;
}

#include "res://td3d/coast_sampling.gdshaderinc"
#include "res://td3d/sea_activity.gdshaderinc"
#include "res://td3d/vessel_water_fill.gdshaderinc"

float ship_foam(vec2 p, float t) {
	float foam = 0.0;
	for (int i = 0; i < 8; i++) {
		if (i >= u_ship_n) break;
		vec4 ship = u_ships[i];
		vec4 motion = u_shipd[i];
		vec2 rel = p - ship.xy;
		float along = dot(rel, motion.xy);
		float across = dot(rel, vec2(-motion.y, motion.x));
		float r = max(ship.z, 1.0);
		float speed = clamp(motion.z, 0.0, 1.0);
		if (max(abs(rel.x), abs(rel.y)) > r * 1.8) continue;
		float beam = max(motion.w, 0.6);
		float hull_z = clamp(along / r, -1.0, 1.0);
		float station = (hull_z * 0.5 + 0.5) * 7.0;
		int left = min(int(floor(station)), 6);
		int right = left + 1;
		float w0 = u_hull_profiles[i * 2 + left / 4][left % 4];
		float w1 = u_hull_profiles[i * 2 + right / 4][right % 4];
		float waterline = mix(w0, w1, station - float(left));
		if (max(w0, w1) < 0.001) waterline = beam * sqrt(max(1.0 - hull_z * hull_z, 0.0));
		float edge_width = max(0.20, min(beam * 0.13, 0.85));
		float contact = exp(-pow((abs(across) - waterline) / edge_width, 2.0))
			* (1.0 - smoothstep(r * 0.94, r * 1.03, abs(along)));
		// Only a compact bow contact follows the hull. All stern foam is history.
		float tip = exp(-pow((along - r * 0.96) / (r * 0.11), 2.0))
			* exp(-pow(across / (r * 0.24), 2.0));
		float shoulder = contact * exp(-pow((along - r * 0.76) / (r * 0.22), 2.0));
		float lace = 0.24 + sea_foam_lace(p, t) * 0.76;
		float moving = smoothstep(0.04, 0.18, speed);
		float hull_foam = contact * (moving * 0.22 + u_rough * 0.06);
		foam = max(foam, max(max(tip * 0.68, shoulder * 0.45) * moving, hull_foam) * lace * ship.w);
	}
	// Evaluate world-space breakup once, not texture fetches for every record.
	float wake_lace = 0.0;
	float wake_gaps = 0.0;
	if (u_wake_n > 0) {
		wake_lace = foam_noise(p * 0.29 + vec2(t * 0.018, -t * 0.014) + vec2(19.0, 53.0));
		wake_gaps = foam_noise(p * 0.074 + vec2(-t * 0.009, t * 0.012) + vec2(-7.0, 31.0));
	}
	// Packet z already includes size + age * 0.8, and w includes lifetime fade.
	// Recover birth size only to keep longitudinal patches short as they widen.
	for (int i = 0; i < 64; i++) {
		if (i >= u_wake_n) break;
		vec4 sample_point = u_wakes[i];
		float age = max(u_wakedirs[i].z, 0.0);
		float size = max(sample_point.z, 1.0);
		float birth_size = max(size - age * 0.8, 1.0);
		vec2 rel = p - sample_point.xy;
		if (sample_point.w <= 0.001 || max(abs(rel.x), abs(rel.y)) > size * 2.8) continue;
		vec2 direction = u_wakedirs[i].xy;
		float along = dot(rel, direction);
		float across = dot(rel, vec2(-direction.y, direction.x));
		float seed = hash21(sample_point.xy * 0.173);
		// A single bent patch has no symmetric rails and stays at its birth site.
		across -= sin(along / birth_size * 2.1 + seed * 6.283 + age * 0.45) * size * 0.16;
		along /= birth_size * 1.4 + age * 0.20;
		across /= size;
		float density = exp(-2.0 * (along * along + across * across));
		float gaps = smoothstep(0.10 + age * 0.022, 0.58 + age * 0.018, wake_gaps);
		float pores = (0.18 + sea_foam_lace(p, t) * 0.82)
			* (0.45 + 0.55 * smoothstep(0.12, 0.58, wake_lace));
		float dispersion = sqrt(birth_size / size);
		foam = max(foam, density * gaps * pores * dispersion * sample_point.w * 1.22);
	}
	return foam;
}

float foam_texture(vec2 p, float t) {
	vec2 advected = p + vec2(t * 0.075, -t * 0.045);
	float broad = foam_noise(advected * 0.24 + vec2(13.0));
	float fine = foam_noise(advected * 0.83 + vec2(31.0, -9.0));
	float pores = foam_noise(advected * 1.91 + vec2(-7.0, 53.0));
	float authored = texture(u_foam_tex, advected * 0.052 + vec2(t * 0.004, -t * 0.003)).r * 0.66
		+ texture(u_foam_tex, advected * 0.147 + vec2(-t * 0.008, t * 0.006) + vec2(17.0)).r * 0.34;
	// A porous foam sheet with soft gaps rather than blurred white disks.
	float holes = smoothstep(0.27, 0.66, broad * 0.65 + fine * 0.35);
	float breakup = smoothstep(0.26, 0.74, authored * 0.72 + pores * 0.28);
	return holes * mix(0.22, 1.0, breakup);
}

float rain_rings(vec2 p, float t) {
	float ring = 0.0;
	for (int layer = 0; layer < 2; layer++) {
		vec2 q = p * (0.25 + float(layer) * 0.13) + vec2(float(layer) * 19.73);
		vec2 cell = floor(q);
		vec2 center = vec2(hash21(cell + 4.7), hash21(cell + 39.2)) * 0.24 + 0.38;
		float seed = hash21(cell + 91.7);
		float age = fract(t * (1.35 + seed * 0.8) + seed * 13.0);
		float radius = age * 0.22;
		float distance_to_center = length(fract(q) - center);
		float crest = exp(-pow((distance_to_center - radius) / 0.016, 2.0));
		float active = step(seed, 0.34);
		ring += crest * (1.0 - age) * smoothstep(0.02, 0.10, age) * active;
	}
	return ring;
}

vec2 impact_coverage(vec2 p) {
	if (u_impact_n < 3) return vec2(0.0);
	float pixel = max(length(fwidth(p)), 0.20);
	float width = max(0.60, pixel * 1.1);
	float edge = 100000.0;
	float negative = 0.0;
	float positive = 0.0;
	for (int i = 0; i < 32; i++) {
		if (i >= u_impact_n) break;
		int j = i + 1;
		if (j >= u_impact_n) j = 0;
		vec2 a = u_impact_outline[i].xy;
		vec2 d = u_impact_outline[j].xy - a;
		vec2 rel = p - a;
		float h = clamp(dot(rel, d) / max(dot(d, d), 0.00001), 0.0, 1.0);
		edge = min(edge, length(rel - d * h));
		float cross_z = d.x * rel.y - d.y * rel.x;
		negative = max(negative, step(cross_z, -0.0001));
		positive = max(positive, step(0.0001, cross_z));
	}
	float inside = 1.0 - negative * positive;
	float marks = 1.0 - smoothstep(width, width + pixel, edge);
	for (int i = 0; i < 32; i++) {
		if (i >= u_impact_point_n) break;
		float ring = abs(length(p - u_impact_points[i].xy) - 2.4);
		marks = max(marks, 1.0 - smoothstep(width * 0.55, width + pixel, ring));
	}
	if (u_impact_burst.w > 0.5) {
		float ring = abs(length(p - u_impact_burst.xy) - u_impact_burst.z);
		marks = max(marks, 1.0 - smoothstep(width * 0.55, width + pixel, ring));
	}
	return vec2(inside * 0.09, marks * 0.93);
}

void vertex() {
	vec4 wp = MODEL_MATRIX * vec4(VERTEX, 1.0);
	vec2 g;
	float height = ocean_height(wp.xz, u_time, g);
	float shore = smoothstep(0.0, 38.0, coast_at(wp.xz).x);
	// The same physical wave field drives hulls, spray and surface effects.
	// View-distance scaling caused floating foam and a calm horizon ring.
	// Displace VERTEX too: lighting, depth effects and SSR must receive the
	// same view-space position that the rasterized surface uses.
	VERTEX.y += height * shore;
	wp = MODEL_MATRIX * vec4(VERTEX, 1.0);
	v_wp = wp.xyz;
	v_world = wp.xyz;
}

void fragment() {
	vec2 p = v_wp.xz;
	float t = u_time;
	vec2 coast = coast_at(p);
	float shore_distance = coast.x;
	// Native depth still occludes ships/terrain. Never paint open water over
	// measured dry ground; foam, shallow absorption and sea are one surface.
	if (shore_distance < -1.2) discard;
	float shore = smoothstep(0.0, 38.0, shore_distance);
	vec2 g;
	vec4 breaker;
	float height = ocean_sample(p, t, g, breaker);
	float dist = distance(CAMERA_POSITION_WORLD, v_wp);
	float footprint = max(length(dFdx(p)), length(dFdy(p)));
	float detail = 1.0 - smoothstep(0.30, 1.60, footprint * 0.079);
	float near_swell = 1.0;
	vec2 ripples = sea_detail_slope(p, t, footprint);
	ripples *= detail * (0.65 + u_rough * 0.50) * mix(0.30, 1.0, shore);
	// The derivative of H * shore includes H * grad(shore). Omitting that
	// term made the normal/reflection abruptly change at the shelf's edge.
	vec2 pdx = dFdx(p);
	vec2 pdy = dFdy(p);
	float determinant = pdx.x * pdy.y - pdx.y * pdy.x;
	vec2 shore_gradient = vec2(0.0);
	if (abs(determinant) > 0.000001) {
		shore_gradient = vec2(dFdx(shore) * pdy.y - dFdy(shore) * pdx.y,
			pdx.x * dFdy(shore) - pdy.x * dFdx(shore)) / determinant;
	}
	vec2 surface_slope = g * shore * near_swell + height * shore_gradient + ripples;
	vec3 n = normalize(vec3(-surface_slope.x, 1.0, -surface_slope.y));
	vec3 view_dir = normalize(CAMERA_POSITION_WORLD - v_wp);
	float ndv = clamp(dot(n, view_dir), 0.0, 1.0);

	// Continuous depth absorption: no separate shallow surface or colour rings.
	float bed_slope = coast.y > 0.0 ? coast.y : 0.32;
	float offshore = max(shore_distance, 0.0);
	float shelf_variation = 0.68 + foam_noise(p * 0.035 + vec2(71.0, -13.0)) * 0.64;
	float shelf_scale = mix(u_shallow_width, 1.0, smoothstep(0.45, 1.15, bed_slope));
	float rocky_shore = smoothstep(0.45, 1.15, bed_slope);
	float bed_depth = 0.60 + rocky_shore * 1.40 + offshore * bed_slope * shelf_variation / shelf_scale;
	// Do not interpolate the empty-terrain sentinel into underwater depth.
	bed_depth = clamp(bed_depth + height * shore, 0.08, 65.0);
	vec2 refracted_bed = p + ripples * min(bed_depth, 8.0) * 2.4;
	float bed_noise = noise2(refracted_bed * 0.037 + vec2(13.0, -7.0));
	float sand_grain = noise2(refracted_bed * 0.43 + vec2(9.0, 47.0));
	vec3 sand = mix(vec3(0.20, 0.175, 0.11), vec3(0.36, 0.31, 0.22), bed_noise);
	sand *= 0.93 + sand_grain * 0.11;
	float sediment = u_rough * u_rough * 0.32 + u_rain * 0.10;
	float optical_depth = bed_depth * (1.0 + sediment) / max(u_clarity, 0.2);
	// Longer optical paths at grazing angles hide the seabed naturally.
	optical_depth *= mix(1.65, 1.0, smoothstep(0.15, 0.85, ndv));
	vec3 transmission = exp(-optical_depth * vec3(0.42, 0.24, 0.16));
	float bottom_visibility = exp(-optical_depth * 0.11);
	vec3 scattering = mix(u_shallow * (0.80 - rocky_shore * 0.16), u_deep, 1.0 - exp(-bed_depth * 0.13));
	vec3 body = scattering * (vec3(1.0) - transmission) + sand * transmission * bottom_visibility;
	// Real opaque seabed refraction near shore. Reject foreground hull pixels
	// and above-water land rather than refracting them into a blue surface.
	float capture_fade = (1.0 - smoothstep(6.0, 22.0, bed_depth)) * smoothstep(0.14, 0.30, ndv);
	if (capture_fade > 0.001) {
		vec2 uv = clamp(SCREEN_UV + ripples * 0.004 * min(bed_depth, 5.0), vec2(0.001), vec2(0.999));
		float raw_depth = texture(u_depth, uv).r;
		vec4 sample_view = INV_PROJECTION_MATRIX * vec4(uv * 2.0 - 1.0, raw_depth, 1.0);
		float scene_depth = -sample_view.z / max(sample_view.w, 0.00001);
		float surface_depth = -(VIEW_MATRIX * vec4(v_wp, 1.0)).z;
		float submerged = smoothstep(0.18, 1.2, scene_depth - surface_depth)
			* (1.0 - smoothstep(20.0, 45.0, scene_depth - surface_depth));
		vec3 refracted = textureLod(u_screen, uv, 0.0).rgb;
		// A finite seabed capture contributes detail to the same optical sand
		// body. It must not replace it with a darker colour at capture limits.
		vec3 captured_sand = clamp(refracted, sand * 0.75, sand * 1.22);
		body += (captured_sand - sand) * transmission * bottom_visibility
			* submerged * capture_fade * 0.55;
	}
	// Deep water needs a small sky-scattered body term at a top-down angle;
	// relying on specular reflection alone leaves open sea unnaturally navy.
	body += u_skyc * (0.026 + 0.018 * ndv) * (1.0 - u_night) * (0.72 + u_rough * 0.28);
	float shallow_light = exp(-optical_depth * 0.30);
	// Refracted sunlight is restrained and restricted to the sandy shallows.
	vec2 cp = p + ripples * 14.0;
	float c0 = noise2(cp * 0.24 + vec2(t * 0.035, -t * 0.024));
	float c1 = noise2(cp * 0.31 + vec2(-t * 0.030, t * 0.026) + vec2(31.0));
	float caustics = pow(clamp(1.0 - abs(c0 - c1) * 6.0, 0.0, 1.0), 10.0);
	vec2 cuv = p * 0.022 + ripples * 0.035 + vec2(t * 0.0021, -t * 0.0017);
	vec3 ctex = texture(u_caustics_tex, cuv).rgb;
	caustics = mix(caustics, max(ctex.r, max(ctex.g, ctex.b)), 0.48);
	float sun_up = clamp(u_sun_dir.y * 1.8, 0.0, 1.0) * (1.0 - u_rough * 0.6);
	body += vec3(0.12, 0.22, 0.20) * caustics * shallow_light * sun_up;
	float crest = clamp(height / max(u_wave_height * (1.0 + u_rough * 0.8) * 3.0, 0.1), 0.0, 1.0);
	float through_crest = pow(max(dot(-view_dir, normalize(u_sun_dir + n * 0.35)), 0.0), 4.0);
	body += u_shallow * crest * through_crest * sun_up * 0.12 * u_crest_glow;
	// Storm lightning is a cold, broad fill on the sea body. It follows wave
	// crests instead of acting as a flat screen flash.
	body += vec3(0.075, 0.13, 0.21) * u_flash * (0.32 + crest * 0.58);
	// Native radiance/SSR supply reflection separately from diffuse body colour.
	vec3 col = body;

	// Local swash follows the shoreline and physical depth on this one surface.
	// Direct world noise gives short independent stretches, with fully dark gaps.
	float coast_delay = foam_noise(p * 0.027 + vec2(5.0, 29.0));
	float phase = fract(t * 0.095 + coast_delay * 0.85);
	float advance = 1.0 - smoothstep(0.08, 0.44, phase);
	float retreat = smoothstep(0.55, 0.94, phase);
	float run = 0.55 + (advance + retreat) * (4.0 + u_rough * 2.8);
	float foam_width = 0.50 + u_rough * 0.42;
	float broken_front = (foam_noise(p * 0.23 + vec2(37.0)) - 0.5) * 1.4;
	float front_distance = abs(shore_distance + broken_front - run);
	float pixel_footprint = min(max(fwidth(shore_distance), 0.15), 1.25);
	float breaking = 1.0 - smoothstep(foam_width * 0.25,
		foam_width * 1.5 + pixel_footprint * 0.45, front_distance);
	breaking *= smoothstep(0.04, 0.18, phase) * (1.0 - smoothstep(0.46, 0.64, phase));
	float wash = (1.0 - smoothstep(foam_width * 0.8,
		foam_width * 2.8 + pixel_footprint * 0.45, front_distance + 0.4))
		* smoothstep(0.50, 0.64, phase) * (1.0 - smoothstep(0.80, 0.97, phase));
	float lace1 = foam_noise(p * 0.91 + vec2(-t * 0.057, t * 0.038) + vec2(17.0));
	float lace = foam_texture(p, t);
	float local_contact = smoothstep(0.30, 0.60,
		foam_noise(p * 0.10 + vec2(t * 0.023, -t * 0.017) + vec2(17.0, -11.0)));
	// Keep contact depth separate from Web's optical sand colour adjustment.
	float contact_depth = max(0.0, 0.18 + offshore * bed_slope * shelf_variation + height * shore);
	float depth_contact = smoothstep(0.02, 0.15, contact_depth)
		* (1.0 - smoothstep(2.2, 6.0, contact_depth));
	// A breaking front is white aerated water. Preserve fine pores while
	// letting its active short stretches read against blue-green shallows.
	float shore_lace = 0.12 + 0.88 * max(lace, 0.0);
	float shore_foam = max(breaking * 1.25, wash * 0.32) * shore_lace * local_contact * depth_contact;
	shore_foam *= smoothstep(-0.7, 0.8, shore_distance)
		* (1.0 - smoothstep(12.0, 18.0, shore_distance));
	float cap_pores = sea_foam_lace(p, t);
	float caps = sea_breaker_foam(p, t, breaker, cap_pores) * shore;
	float wake = ship_foam(p, t);
	float rain = 0.0;
	if (u_rain > 0.02) {
		rain = rain_rings(p, t) * u_rain * detail * 0.08;
	}
	// Overlapping foam sources share coverage rather than adding white layers.
	float foam = clamp((max(shore_foam, max(caps, wake)) + rain)
		* u_foam_strength, 0.0, 1.0);
	// Foam opacity is coverage on the one water surface. Blending here keeps
	// the water under holes visible without adding a second transparent plane.
	float foam_coverage = (1.0 - exp(-foam * 2.3)) * u_foam_opacity;
	col = mix(col, u_foam * (0.89 + lace1 * 0.10), foam_coverage);
	if (u_impact_n >= 3) {
		vec2 impact = impact_coverage(p);
		vec3 impact_color = mix(vec3(0.95, 0.16, 0.05), vec3(1.0, 0.70, 0.12), u_impact_ready);
		col = mix(col, impact_color, max(impact.x, impact.y));
	}
	ALBEDO = raid_zone_surface(col, p);
	NORMAL = normalize((VIEW_MATRIX * vec4(n, 0.0)).xyz);
	METALLIC = 0.0;
	SPECULAR = 0.5;
	ROUGHNESS = mix(0.13 + u_rough * 0.16 + (1.0 - detail) * 0.09, 0.82, foam_coverage);
	// Back-lit thin wave crests transmit sunlight; do not illuminate the full
	// body or white foam with emission. Air extinction remains engine-owned.
	EMISSION = u_shallow * crest * through_crest * sun_up * 0.14 * u_crest_glow
		* (1.0 - foam_coverage) * cloud_transmittance(v_world)
		+ vec3(0.10, 0.17, 0.27) * u_flash * (0.18 + crest * 0.62)
		* (1.0 - foam_coverage)
		+ vessel_water_fill(p, n) * (1.0 - foam_coverage * 0.60);
	// Apply air extinction after lighting, using the same colour as the sky
	// horizon. Near water keeps its contrast and sea/sky converge at range.
	float air_distance = max(length(p - CAMERA_POSITION_WORLD.xz) - 320.0, 0.0);
	float aerial = mix(0.35, 1.0, 1.0 - view_dir.y * view_dir.y);
	FOG = vec4(u_air_color, 1.0 - exp(-air_distance * u_air_density * aerial));
}
#include "res://td3d/surface_light.gdshaderinc"
