ÙÞ!Ë#'	‘•ð|(êbÿ•j¶ÓÇK3’{ésÂ¡² oþJ7«ÙeÛ`·øcÞënß.øÁ½Ê·Úq<á{t¾‚ÌiÜÞÍMoœþ“«íŒ­§\]Ÿy·½Õ+€q²Û¿b­3—xk{Ï-ÆkAÇßù;þ³xÏîû";5ŠÄE›^Ìîùá“A9WñäkÞ{V±‘¯Þ*Gz!™ÖãnOõ%ù·m·0lÿ!^º†qèygßªéº™D{ªCVr.ig'3ÚµP‡ñ¡,ä‹=½ñÒ*›ù£_(Ýô“ÝiŒè#Û„Çv#G Ü’ŽñÂ§Î?¼Øâ;[š'`ìÖþÒ7Ú{Mºé_ú£bUË1N#ß±å®qð¿1øãþt¿p;V°Ï!«ü¯,.Þô¿ý À	¬+îðfuE§½¸N+␀␀␀␀␀␀␀␀// Shared measured coastline for the ocean and water-following navigation.
vec2 coast_at(vec2 p) {
	vec2 best = vec2(10000.0, -1000.0);
	for (int i = 0; i < 32; i++) {
		if (i >= u_coast_n) break;
		vec4 bb = u_coast_bounds[i];
		vec2 uv = (p - bb.xy) / bb.zw;
		if (min(uv.x, uv.y) >= 0.0 && max(uv.x, uv.y) <= 1.0) {
			vec2 sampled = textureLod(u_coast_tex, vec3(uv, float(i)), 0.0).rg;
			if (sampled.x < best.x) best = sampled;
		}
	}
	return best;
}
