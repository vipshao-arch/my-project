global uniform vec2 env_cloud_offset;
global uniform float env_cloud_coverage;
global uniform float env_cloud_shadow_strength;
global uniform vec3 env_cloud_light_dir;
global uniform float env_wetness;
uniform vec4 expected_cloud;
uniform vec3 expected_direction;
uniform float expected_wet;
void fragment() {
	float error = length(env_cloud_offset - expected_cloud.xy)
		+ abs(env_cloud_coverage - expected_cloud.z)
		+ abs(env_cloud_shadow_strength - expected_cloud.w)
		+ length(env_cloud_light_dir - expected_direction)
		+ abs(env_wetness - expected_wet);
	COLOR = vec4(error < 0.001 ? vec3(0.10, 0.80, 0.34) : vec3(1.0, 0.08, 0.04), 1.0);
}
