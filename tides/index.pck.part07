\`rf.˜»ÿë&›:·Í#ÍÐƒOJúcZš9+9î6–àc~‚¡ë$ßäë€ùÜÎ)XX¡]cÐŠíæÅk~Ç	␀¯·§œUc3°ìk·ÏÉ€Ÿþb¨Åÿ§l®÷û±ºáa%÷šñ5€üÍþYiOEu¿ò4àVëÃ+Î/1êßø²éÚëP4š5ª‰ÅGIîD³O˜àvòçF­‘Y'²îe;¶åÿfŒšÌj†<»Ùø«;#WÉêíMÞ`áÂ•é¼~‘¦8¾4±é$ž_‚ƒéVÛ|ÊAÔñÉÕa“ÜÀåO›iÓ¶ƒˆCèmF1O´_à–;ˆãI4rýj½óÿ€w´‡JeIò¸æoŒ¦SeH›=H–Z°KÂ#¬?bÇÄ¸z¶úÇ¿8R¯ß(‡®Û ›6>˜¸TdV¢³&8J-t	W¹c¬Ã:É÷Â‚/øUÌþ* EŸ]o¦?¸²Ý¸öåK_¸lZWÜqµßFÐZQûSÖî`îA‡„nC=ëÑåË†õÊ&ü^[ðñ·Ky^jzÃN>PÈö­ð›ë»JÿØê^uåëÊ~òèBáý¥3¢ÖM;>§¾5Ûû{ÕýäÄ{P°	¥ãþgxÇè~€úEq\ò“ÀýÿÄWÐÁB²NÂý®Ûƒã×Dë!‡§ÞRŽË{jhzümŽüÏyŽÉø9ëKÎÀmßÎ˜òž*ÐegÝ½Ž›üØA␀ÃWS$g.ÈùÀyfïë]y=”‡ÛÛ	æÃ›q[zó°;c6¹gêþŒËxä:ˆÐ2ttŒs®ÅØ&´ýL©÷P±o,ÿÅÐS·[ï˜c[úñyÆèw@ Àshader_type spatial;
render_mode unshaded, cull_disabled, depth_draw_never, blend_add, shadows_disabled;

uniform sampler2D u_tex : filter_linear, repeat_disable;
uniform vec4 u_color : source_color = vec4(1.0);
uniform vec2 u_cell = vec2(0.0);
uniform vec2 u_grid = vec2(1.0);
uniform float u_opacity = 1.0;
uniform float u_rotation = 0.0;
uniform float u_clip = 0.0;
uniform float u_luma_alpha = 0.0;

void vertex() {
	MODELVIEW_MATRIX = VIEW_MATRIX * mat4(
		vec4(INV_VIEW_MATRIX[0].xyz, 0.0),
		vec4(INV_VIEW_MATRIX[1].xyz, 0.0),
		vec4(INV_VIEW_MATRIX[2].xyz, 0.0),
		vec4(MODEL_MATRIX[3].xyz, 1.0)
	);
	MODELVIEW_MATRIX = MODELVIEW_MATRIX * mat4(
		vec4(length(MODEL_MATRIX[0].xyz), 0.0, 0.0, 0.0),
		vec4(0.0, length(MODEL_MATRIX[1].xyz), 0.0, 0.0),
		vec4(0.0, 0.0, length(MODEL_MATRIX[2].xyz), 0.0),
		vec4(0.0, 0.0, 0.0, 1.0)
	);
}

void fragment() {
	vec2 local = UV - 0.5;
	float c = cos(u_rotation);
	float s = sin(u_rotation);
	local = vec2(local.x * c - local.y * s, local.x * s + local.y * c) + 0.5;
	vec2 uv = (u_cell + clamp(local, vec2(0.001), vec2(0.999))) / u_grid;
	vec4 texel = texture(u_tex, uv);
	float luma = dot(texel.rgb, vec3(0.2126, 0.7152, 0.0722));
	float derived_alpha = smoothstep(0.025, 0.32, luma);
	float texture_alpha = mix(texel.a, texel.a * derived_alpha, u_luma_alpha);
	float radial = 1.0 - smoothstep(0.46, 0.71, length(UV - 0.5));
	texture_alpha *= mix(1.0, radial, u_luma_alpha * 0.72);
	float alpha = texture_alpha * u_opacity * u_color.a;
	if (u_clip > 0.5) alpha *= smoothstep(0.60, 0.30, length(UV - 0.5));
	if (alpha < 0.025) discard;
	ALBEDO = texel.rgb * u_color.rgb * 0.72;
	ALPHA = alpha;
}
␀␀␀shader_type spatial;
render_mode unshaded, cull_disabled, depth_draw_never, blend_mix, shadows_disabled;

uniform sampler2D u_tex : filter_linear, repeat_disable;
uniform vec4 u_color : source_color = vec4(1.0);
uniform vec2 u_cell = vec2(0.0);
uniform vec2 u_grid = vec2(1.0);
uniform float u_opacity = 1.0;
uniform float u_rotation = 0.0;
uniform float u_clip = 0.0;
uniform float u_luma_alpha = 0.0;

void vertex() {
	MODELVIEW_MATRIX = VIEW_MATRIX * mat4(
		vec4(INV_VIEW_MATRIX[0].xyz, 0.0),
		vec4(INV_VIEW_MATRIX[1].xyz, 0.0),
		vec4(INV_VIEW_MATRIX[2].xyz, 0.0),
		vec4(MODEL_MATRIX[3].xyz, 1.0)
	);
	MODELVIEW_MATRIX = MODELVIEW_MATRIX * mat4(
		vec4(length(MODEL_MATRIX[0].xyz), 0.0, 0.0, 0.0),
		vec4(0.0, length(MODEL_MATRIX[1].xyz), 0.0, 0.0),
		vec4(0.0, 0.0, length(MODEL_MATRIX[2].xyz), 0.0),
		vec4(0.0, 0.0, 0.0, 1.0)
	);
}

void fragment() {
	vec2 local = UV - 0.5;
	float c = cos(u_rotation);
	float s = sin(u_rotation);
	local = vec2(local.x * c - local.y * s, local.x * s + local.y * c) + 0.5;
	vec2 uv = (u_cell + clamp(local, vec2(0.001), vec2(0.999))) / u_grid;
	vec4 texel = texture(u_tex, uv);
	float luma = dot(texel.rgb, vec3(0.2126, 0.7152, 0.0722));
	float derived_alpha = smoothstep(0.025, 0.32, luma);
	float texture_alpha = mix(texel.a, texel.a * derived_alpha, u_luma_alpha);
	float radial = 1.0 - smoothstep(0.46, 0.71, length(UV - 0.5));
	texture_alpha *= mix(1.0, radial, u_luma_alpha * 0.72);
	float alpha = texture_alpha * u_opacity * u_color.a;
	if (u_clip > 0.5) alpha *= smoothstep(0.60, 0.30, length(UV - 0.5));
	if (alpha < 0.025) discard;
	// The kit atlas contains soot-black frames. Lift their RGB with the same
	// alpha silhouette so near-camera smoke does not become an opaque black disc.
	ALBEDO = texel.rgb * u_color.rgb + u_color.rgb * texture_alpha * 0.16;
	ALPHA = alpha;
}
