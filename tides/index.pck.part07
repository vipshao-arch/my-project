7 ’yª=x}ò'ÇíÝ	êpÑhû‡8txY“Yg¼knâ÷ù­W˜ûJ½»^ÿd2ÅnÎ/rùƒ5‰¤Q>Jåx½á¨Ç¤÷¿½FŸîyhG/9¥›ó°F°üö=×~pÈ}Îþ^xÄö4y²þ$|;û§ìŒé[÷>¡:k}ŸwD_N©Á_x‡ó?lú¥[íæÓ@pž.‘žo{Þßg_˜QÙ‰º–¤I¾!Ìßùˆ_p„[À…Í)x!ãS¿ZúÖç þ2ÝÊ¸¢˜ràü_ÜÛ^:6‘ßIà˜¬,o|ãKË—ó‰(žEcú‚^rºwñ•‡ÜŒ8[ÒIÅ-Ø{$~Œå?l©+~ÆaÔÑö¾ÒãÇh×õ	tè ¹2ÿqcO=ØòÝv¿ÎYù˜‹aQaËÍátþûã¬ŸÄõïÅ“îèÿ±$¶u]¿–/NþÿÑ	zwÀFûÎÆŸf“ûÀN—ŸõÖKúõ)½¾º0‹9ÊÃ—½÷"Î`œOsŸ6¾ÒíN«vá—»Ð[␀␀␀␀␀␀␀␀␀␀␀␀␀␀// Project-owned volumetric cloud approximation. No native binary texture bundle
// required: a seamless 3D density field with explicit texture sampling.
uniform float u_cloud_quality = 1.0;
uniform sampler3D u_cloud_volume_tex : filter_linear, repeat_enable;

float cloud_volume_density(vec3 pos, float lod, float segment) {
	float altitude = (pos.y - 1800.0) / 1100.0;
	float profile = smoothstep(0.0, 0.17, altitude) * (1.0 - smoothstep(0.55, 1.0, altitude));
	float macro = cloud_density_filtered(pos.xz, lod);
	vec3 q = (pos - vec3(env_cloud_offset.x, 0.0, env_cloud_offset.y)) * vec3(0.00012, 0.00024, 0.00012);
	float detail = textureLod(u_cloud_volume_tex, q, 0.0).r;
	// The 3D noise has no mip chain: smoothly remove unresolved erosion.
	detail = mix(detail, 0.5, smoothstep(400.0, 1600.0, segment));
	// Shape density in 3D rather than extruding a projected cloud mask into pillars.
	float threshold = mix(0.74, 0.24, env_cloud_coverage);
	float shape = smoothstep(threshold - 0.12, threshold + 0.18, detail * 0.72 + macro * 0.28);
	return shape * profile;
}

vec4 integrate_project_cloud(vec3 origin, vec3 direction, vec3 sunlight,
		vec3 sun_color, float sun_energy, float night, float rough, float mie, float jitter) {
	if (direction.y <= 0.015) return vec4(0.0);
	float enter = max((1800.0 - origin.y) / direction.y, 0.0);
	float leave = (2900.0 - origin.y) / direction.y;
	float max_distance = 48000.0;
	if (leave <= enter || enter >= max_distance) return vec4(0.0);
	leave = min(leave, max_distance);
	int steps = u_cloud_quality > 0.5 ? 48 : 8;
	float step_length = (leave - enter) / float(steps);
	// Regular ray samples must not alias the fine 2D macro field at low angles.
	// A sample represents the full segment, not an infinitesimal point.
	float lod = max(log2(max(step_length * 0.024064 * length(direction.xz), 1.0)), 0.0);
	float transmittance = 1.0;
	vec3 radiance = vec3(0.0);
	for (int i = 0; i < 48; i++) {
		if (i >= steps || transmittance < 0.015) break;
		vec3 p = origin + direction * (enter + (float(i) + jitter) * step_length);
		float density = cloud_volume_density(p, lod, step_length);
		if (density < 0.002) continue;
		float sun_density = cloud_volume_density(p + sunlight * 190.0, lod, step_length);
		if (steps > 8) sun_density += cloud_volume_density(p + sunlight * 420.0, lod, step_length) * 0.5;
		float shadow = exp(-sun_density * 3.5);
		float scattering = 1.0 - exp(-density * step_length * 0.0018);
		vec3 fill = mix(vec3(0.15, 0.22, 0.32), vec3(0.10, 0.13, 0.17), rough);
		vec3 lit = fill + sun_color * (0.28 + shadow * 0.46 + mie * 0.008) * min(sun_energy, 2.0);
		lit = mix(lit, vec3(0.025, 0.039, 0.070) * (0.55 + shadow * 0.45), night);
		radiance += transmittance * scattering * lit;
		transmittance *= 1.0 - scattering;
	}
	float opacity = 1.0 - transmittance;
	return vec4(radiance / max(opacity, 0.001), opacity);
}
