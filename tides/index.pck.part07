úïß¶øÄä‹–Œ´<r}ç˜Ž3å/»6X]ì=ê.æ+¸Õ÷/~ÝºpÈ¼Ñ†±•}o§'Ùx›Ævþ…þÞ1´·=ÕØýÒqÀÁÄ³JÁ9PçÝýƒ–üw áÁY¾É÷Î÷gïð;XÐ7ð”ç¿á»=ñGÿ;¸Ìîj{Å˜nÇ2ÆƒÙéeö±'_é¨Î=”V+É©„×_ÆSå¬Ú\:p|4>Gñõ–ÒvÍîƒ]8^r°yÞo”ðk™.è‡ezæÖãÏòæÌÆêÍÒß9ÂSÚg÷ßF3¯þ¯©WL/Ó™]·cuw>þ|~,¢¾Ck ž
lŸþ²:œ‡Rkcöw¦²¾˜V’vµî+ö¸Ù´þÐmBïØ\ñ¿{…ÔíEÓ]ÎM÷½␀{ÝÇTùH¡óa`ã¥t³ó~ÀßËÓðBÝ$uÂ_^ÿÌuDIf/WaK×¯÷i2áè›”OªqŽ‡fF¹åëdRüÒþøí™f13âfþŠg\C°×BézœÌþÄ°ñß¿æîúúøk{0úª¸?æÏÑ„Á¦ì¢CsMîƒñ€å‚¿¥é-çåöuïu±si¾7[ço^4Ï{pœ^ªóŸõøÚXÿ­¡…ü¸ô␀†1òìwïö÷øYðÈtýWÙŸ&ï_ ^ùö~$Ì³zÓúôïû-œ_ÿ÷Á?úÛ?à]_†°þ­•ÖgŸ=™×‡ç‘±fî~»§ŸÅßÌ1­›\Íœ{æØ/
Ò·ÖXeoÂÎøps7èÂy1†}Ü§©üã¯åI~ÛvìËfÚ¦í°Ü–x¦wï3|2-óz¿5&‘`‚‰aÑ~8z›ž¹ñn=º␀␀␀␀␀␀␀␀␀␀␀␀␀// Stochastic triangle sampling: neighbours have independent normal-map
// rotations/offsets, blended smoothly without a repeating square tile.
vec2 sea_tile_hash(vec2 p) {
	vec3 q = fract(vec3(p.xyx) * vec3(0.1031, 0.1030, 0.0973));
	q += dot(q, q.yzx + 33.33);
	return fract((q.xx + q.yz) * q.zy);
}

vec2 sea_tile_normal(vec2 uv, vec2 id) {
	vec2 h = sea_tile_hash(id);
	float a = h.x * 6.2831853;
	mat2 r = mat2(vec2(cos(a), sin(a)), vec2(-sin(a), cos(a)));
	// Offset/rotation changes at cell edges must not contaminate mip selection.
	vec2 slope = textureGrad(u_norm_tex, r * uv + h * 5.0,
		r * dFdx(uv), r * dFdy(uv)).rg * 2.0 - 1.0;
	return transpose(r) * slope;
}

vec2 sea_stochastic_normal(vec2 uv) {
	vec2 skew = vec2(uv.x - uv.y * 0.577350269, uv.y * 1.154700538);
	vec2 cell = floor(skew);
	vec2 f = fract(skew);
	vec2 a = cell;
	vec2 b = cell + vec2(1.0, 0.0);
	vec2 c = cell + vec2(0.0, 1.0);
	vec3 weights = vec3(1.0 - f.x - f.y, f.x, f.y);
	if (f.x + f.y > 1.0) {
		a += vec2(1.0);
		weights = vec3(f.x + f.y - 1.0, 1.0 - f.y, 1.0 - f.x);
	}
	weights = weights * weights * weights;
	weights /= max(weights.x + weights.y + weights.z, 0.00001);
	// Preserve slope variance across blends; otherwise the triangulation is
	// visible as a repeating roughness grid even when sample offsets differ.
	return (sea_tile_normal(uv, a) * weights.x + sea_tile_normal(uv, b) * weights.y
		+ sea_tile_normal(uv, c) * weights.z) / sqrt(max(dot(weights, weights), 0.001));
}

vec2 sea_detail_slope(vec2 p, float t, float footprint) {
	vec3 wind = visual_wind(p);
	// Bounded cross drift maintains a continuous field at large world positions.
	vec2 q = p + vec2(t * 0.13, -t * 0.08)
		+ vec2(sin(p.y * 0.012 + t * 0.16), sin(p.x * 0.010 - t * 0.13)) * 1.8;
	vec2 result = vec2(0.0);
	for (int i = 0; i < 3; i++) {
		float scale = 0.034;
		mat2 r = mat2(vec2(0.80, 0.60), vec2(-0.60, 0.80));
		float weight = 0.17;
		if (i == 1) { scale = 0.079; r = mat2(vec2(0.36, -0.93), vec2(0.93, 0.36)); weight = 0.133; }
		if (i == 2) { scale = 0.173; r = mat2(vec2(-0.71, 0.70), vec2(-0.70, -0.71)); weight = 0.062; }
		vec2 uv = r * q * scale + vec2(0.37, 0.73) * float(i + 1);
		// Each texture covers 1024 texels; spatial mip filtering removes tiny
		// normals in the high camera instead of turning them into a square grid.
		vec2 d = sea_stochastic_normal(uv);
		float resolved = 1.0 - smoothstep(0.18, 0.85, footprint * scale);
		result += transpose(r) * d * weight * resolved;
	}
	// Passing gusts alter small-wave contrast and broaden moving glints.
	result *= clamp(0.65 + wind.z * 0.80, 0.65, 1.55);
	// Wind changes contrast, not dot(p,d)'s basis: rotating a phase over
	// large world coordinates creates distance-dependent apparent velocity.
	vec2 wave_axis = vec2(cos(u_wave_dir), sin(u_wave_dir));
	vec2 across = vec2(-wave_axis.y, wave_axis.x);
	float capillary = sin(dot(p,wave_axis)*1.7 - t*0.70
		+ sin(dot(p,across)*0.12)*1.8);
	result += wind.xy * capillary * (0.009 + wind.z*0.016)
		* (1.0 - smoothstep(0.3, 1.8, footprint));
	return result;
}

float sea_foam_lace(vec2 p, float t) {
	vec2 q = p + vec2(t * 0.045, -t * 0.023);
	float a = texture(u_foam_tex, q * 0.064).r;
	vec2 r = vec2(q.x * 0.80 + q.y * 0.60, -q.x * 0.60 + q.y * 0.80);
	float b = texture(u_foam_tex, r * 0.0917 + vec2(0.31, 0.57)).r;
	return smoothstep(0.12, 0.76, a * 0.65 + b * 0.35);
}
