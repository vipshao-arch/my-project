Ÿ%&¹ÖŒ8÷®§ºû:™$˜ý½óÚ_œO™¿:±9á;7¦Í#>L·9O½ðmÞð6ª<wœ!8—Ü¸òÀNfSR‡`]îé`s«8³[,Â÷Â_ßÂK9fº2¸ÅâÇÚä{Î/êfÍCœ‹õÊh!h"òƒÐBËãÿ{ÜrüÝÈÓ 5¹S¾žìJ±ékq¼␀ŸíÛê‹ÝßCÃeúbºÀ±•l¾ð¶fÅqXª½o‰Ÿà­O{ÁùOG™·;\Ó¼õÒ{#5‡]ú8w`ï„_’·D|þÎ<Ì×°§t#ãƒ×ãÞ<y¸$7ÊÏâ.˜ýY~¯ìóí0Y¿Á#}ä„¶„cû€{’W¹}øzlÝðŒ³u™òW¼¬·jx^ýÓïúáó~ù_+Ï†0Çþòç½Jß­¬>?Á.·/œ8-~ûhshader_type spatial;
render_mode cull_disabled, diffuse_burley, specular_schlick_ggx;

uniform sampler2D u_albedo_tex : source_color, filter_linear_mipmap;
uniform sampler2D u_emission_tex : source_color, filter_linear_mipmap;
uniform vec4 u_albedo : source_color = vec4(1.0);
uniform vec3 u_emission : source_color = vec3(0.0);
uniform float u_roughness = 0.8;
uniform float u_metallic = 0.0;
uniform bool u_has_texture = false;
uniform bool u_has_emission = false;
uniform bool u_vertex_color = false;
uniform sampler2D u_shore_tex : filter_linear, repeat_disable;
uniform vec4 u_shore_bounds;
uniform bool u_has_shore = false;
global uniform float env_wetness;
uniform float u_wet_response = 1.0;
varying vec3 v_world;

#include "res://td3d/cloud_field.gdshaderinc"
#include "res://td3d/environment/wind_motion.gdshaderinc"

void vertex() {
	VERTEX = wind_deform(VERTEX, MODEL_MATRIX);
	v_world = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
}
void fragment() {
	if (!FRONT_FACING) NORMAL = -NORMAL;
	vec3 base = u_albedo.rgb;
	if (u_has_texture) base *= texture(u_albedo_tex, UV).rgb;
	if (u_vertex_color) base *= COLOR.rgb;
	float upward = clamp((INV_VIEW_MATRIX * vec4(NORMAL, 0.0)).y, 0.0, 1.0);
	float coastal_wet = (1.0 - smoothstep(0.1, 1.1, abs(v_world.y))) * 0.42;
	float wet = clamp(max(env_wetness * mix(0.35, 1.0, upward), coastal_wet)
		* u_wet_response, 0.0, 1.0);
	if (u_has_shore && v_world.y < 4.0) {
		vec2 uv = (v_world.xz - u_shore_bounds.xy) / u_shore_bounds.zw;
		if (min(uv.x, uv.y) >= 0.0 && max(uv.x, uv.y) <= 1.0) {
			float shore_d = texture(u_shore_tex, uv).r;
			float irregular = sin(dot(v_world.xz, vec2(0.021, 0.013))
				+ sin(dot(v_world.xz, vec2(-0.015, 0.026))) * 1.8);
			float wash = sin(TIME * 0.43 + irregular * 2.25) * 0.6;
			wet = max(wet, (1.0 - smoothstep(0.3, 3.6 + irregular, abs(shore_d + 1.0 + wash)))
				* upward * 0.48 * (1.0 - smoothstep(0.4, 2.2, v_world.y)));
		}
	}
	ALBEDO = base * mix(1.0, 0.72, wet);
	ROUGHNESS = mix(u_roughness, max(u_roughness * 0.52, 0.26), wet);
	METALLIC = u_metallic;
	SPECULAR = 0.5;
	BACKLIGHT = base * (u_wind_mode == 1 ? 0.16 : 0.0);
	EMISSION = u_emission;
	if (u_has_emission) EMISSION *= texture(u_emission_tex, UV).rgb;
}
#include "res://td3d/surface_light.gdshaderinc"
␀␀␀␀␀␀␀␀␀␀␀␀␀shader_type spatial;
render_mode cull_disabled, diffuse_burley, specular_schlick_ggx, fog_disabled;

uniform sampler2D u_albedo_tex : source_color, filter_linear_mipmap;
uniform sampler2D u_emission_tex : source_color, filter_linear_mipmap;
uniform vec4 u_albedo : source_color = vec4(1.0);
uniform vec3 u_emission : source_color = vec3(0.0);
uniform float u_roughness = 0.8;
uniform float u_metallic = 0.0;
uniform bool u_has_texture = false;
uniform bool u_has_emission = false;
uniform bool u_vertex_color = false;
global uniform float env_wetness;
uniform float u_wet_response = 1.0;
varying vec3 v_world;
uniform sampler2D u_shore_tex : filter_linear, repeat_disable;
uniform vec4 u_shore_bounds;
uniform bool u_has_shore = false;
global uniform vec4 env_web_fog_color;
global uniform float env_web_fog_density;
#include "res://td3d/cloud_field.gdshaderinc"
#include "res://td3d/environment/wind_motion.gdshaderinc"

void vertex() {
	VERTEX = wind_deform(VERTEX, MODEL_MATRIX);
	v_world = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
}
void fragment() {
	if (!FRONT_FACING) NORMAL = -NORMAL;
	vec3 base = u_albedo.rgb;
	if (u_has_texture) base *= texture(u_albedo_tex, UV).rgb;
	if (u_vertex_color) base *= COLOR.rgb;
	float upward = clamp((INV_VIEW_MATRIX * vec4(NORMAL, 0.0)).y, 0.0, 1.0);
	float coastal_wet = (1.0 - smoothstep(0.1, 1.1, abs(v_world.y))) * 0.42;
	float wet = clamp(max(env_wetness * mix(0.35, 1.0, upward), coastal_wet)
		* u_wet_response, 0.0, 1.0);
	if (u_has_shore) {
		vec2 uv = (v_world.xz - u_shore_bounds.xy) / u_shore_bounds.zw;
		if (min(uv.x, uv.y) >= 0.0 && max(uv.x, uv.y) <= 1.0 && v_world.y < 5.0) {
			float d = texture(u_shore_tex, uv).r;
			// Wet sand varies along actual terrain; it does not outline the whole coast.
			float local_wash = 0.5 + 0.5 * sin(dot(v_world.xz, vec2(0.021, 0.013))
				+ sin(dot(v_world.xz, vec2(-0.015, 0.026))) * 1.8);
			float wash = sin(TIME * 0.43 + local_wash * 4.5) * 0.6;
			float width = mix(2.4, 5.0, local_wash);
			wet = max(wet, (1.0 - smoothstep(0.35, width, abs(d + 1.0 + wash)))
				* upward * mix(0.24, 0.52, local_wash));
		}
	}
	ALBEDO = base * mix(1.0, 0.72, wet);
	ALBEDO *= mix(1.0, cloud_transmittance(v_world), 0.55);
	float distance_fog = 1.0 - exp(-max(distance(CAMERA_POSITION_WORLD, v_world) - 260.0, 0.0) * env_web_fog_density);
	float grey = dot(ALBEDO, vec3(0.2126, 0.7152, 0.0722));
	ALBEDO = mix(ALBEDO, vec3(grey), distance_fog * 0.40) * (1.0 - distance_fog);
	AO = mix(0.86, 1.0, upward);
	AO_LIGHT_AFFECT = 0.15;
	ROUGHNESS = mix(u_roughness, max(u_roughness * 0.42, 0.22), wet);
	METALLIC = u_metallic;
	SPECULAR = 0.5;
	BACKLIGHT = base * (u_wind_mode == 1 ? 0.12 : 0.0);
	EMISSION = u_emission;
	if (u_has_emission) EMISSION *= texture(u_emission_tex, UV).rgb;
	// Compatibility decodes EMISSION itself. Mix its source colours in linear
	// light first so haze agrees with Web water and sky at intermediate distances.
	vec3 emitted = EMISSION;
	vec3 fog_col = env_web_fog_color.rgb;
	if (OUTPUT_IS_SRGB) {
		emitted = mix(emitted / 12.92, pow((emitted + 0.055) / 1.055, vec3(2.4)), step(vec3(0.04045), emitted));
		fog_col = mix(fog_col / 12.92, pow((fog_col + 0.055) / 1.055, vec3(2.4)), step(vec3(0.04045), fog_col));
	}
	emitted = max(emitted * (1.0 - distance_fog) + fog_col * distance_fog, vec3(0.0));
	if (OUTPUT_IS_SRGB) {
		emitted = mix(emitted * 12.92, 1.055 * pow(emitted, vec3(1.0 / 2.4)) - 0.055, step(vec3(0.0031308), emitted));
	}
	EMISSION = emitted;
}
// Use the Compatibility renderer's built-in light function on Web.
