Ç|èaË¼™S>¬r÷ÑŸ@&î^åî¼Æî1‘½¯Ê-Œ„—Ü›p—Šs×ÇÃ§n¡«þ8_¾uôÃgüséÒÒ/«uKq¡Ü_³ó‘31ñÊcÔnéØ?cþÓît˜¥¯§gnôô¯›
cÝâomÞ	”¶SL·ÂD­þ!kæÄ|›Éä\Íþ5?‡ xùqÁ>]™O.¾À·ŸØK0Òßï­Œ¾œ&ãsƒÇž@~†Ø0^<÷/±¦çpYðq®ˆ¼‚½‰Çö¿76ŒÏß×p1Ê¸¸9œoð{Ç{ƒÝiéŠ‡ðFs¸ç¿°ËoÓÞk[Þqü%^V26¶␀␀shader_type sky;

uniform vec3 u_sun_dir = vec3(0.3, 0.7, 0.5);
uniform vec3 u_sun_col : source_color = vec3(1.0, 0.96, 0.88);
uniform float u_sun_e = 1.5;
uniform vec3 u_moon_dir = vec3(0.23, 0.32, -0.92);
uniform float u_sun_visibility = 1.0;
uniform float u_moon_visibility = 0.0;
uniform float u_stars_visibility = 0.0;
uniform mat3 u_star_basis = mat3(1.0);
uniform vec2 u_disks = vec2(1.0);
uniform float u_night = 0.0;
uniform float u_rough = 0.22;
uniform float u_warm = 0.0;
uniform vec3 u_camera = vec3(0.0);
uniform bool u_web = false;
uniform vec3 u_air_color : source_color = vec3(0.47, 0.61, 0.72);
// Used only by the saved cloud diagnostic scene; normal rendering is zero.
uniform int u_cloud_probe = 0;
global uniform vec4 env_web_fog_color;

#include "res://td3d/cloud_field.gdshaderinc"
#include "res://td3d/cloud_volume_project.gdshaderinc"

float star_hash(vec3 p) {
	p = fract(p * 0.1031);
	p += dot(p, p.yzx + 33.33);
	return fract((p.x + p.y) * p.z);
}

// Angular star positions are fixed on the celestial sphere. Neighbor sampling
// avoids the old 3D voxel faces, including across the longitude seam.
vec3 star_field(vec3 direction) {
	vec3 d = transpose(u_star_basis) * direction;
	vec2 grid = vec2(180.0, 90.0);
	vec2 uv = vec2(atan(d.x, d.z) / 6.2831853 + 0.5,
		asin(clamp(d.y, -1.0, 1.0)) / 3.14159265 + 0.5);
	vec2 cell = floor(uv * grid);
	vec3 light = vec3(0.0);
	for (int y = -1; y <= 1; y++) {
		for (int x = -1; x <= 1; x++) {
			vec2 id = cell + vec2(float(x), float(y));
			id.x = mod(id.x + grid.x, grid.x);
			if (id.y < 0.0 || id.y >= grid.y) continue;
			float seed = star_hash(vec3(id, 17.0));
			if (seed < 0.965) continue;
			vec2 point = (id + vec2(star_hash(vec3(id, 41.0)),
				star_hash(vec3(id, 73.0)))) / grid;
			float lon = (point.x - 0.5) * 6.2831853;
			float lat = (point.y - 0.5) * 3.14159265;
			vec3 star_dir = vec3(sin(lon) * cos(lat), sin(lat), cos(lon) * cos(lat));
			float radius = mix(0.00085, 0.00165, star_hash(vec3(id, 29.0)));
			float distance = length(d - star_dir);
			float spot = exp(-distance * distance / (radius * radius));
			vec3 tint = mix(vec3(0.57, 0.72, 1.0), vec3(1.0, 0.86, 0.66), seed);
			light += tint * spot * mix(0.35, 0.85, seed);
		}
	}
	return light;
}

vec3 sky_linear(vec3 color) {
	return mix(color / 12.92, pow((color + 0.055) / 1.055, vec3(2.4)),
		step(vec3(0.04045), color));
}

void sky() {
	vec3 d = normalize(EYEDIR);
	vec3 sd = normalize(u_sun_dir);
	vec3 sun_col = u_sun_col;
	if (u_web) sun_col = sky_linear(sun_col);
	float mu = max(d.y, 0.035);
	float cos_sun = clamp(dot(d, sd), -1.0, 1.0);
	float rayleigh_phase = 0.75 * (1.0 + cos_sun * cos_sun);
	float g = 0.76;
	float mie_phase = (1.0 - g * g)
		/ pow(max(1.0 + g * g - 2.0 * g * cos_sun, 0.01), 1.5);
	mie_phase = min(mie_phase, 16.0);
	// Analytic single-scattering approximation; no painted horizon seam.
	float optical_path = 1.0 / (mu + 0.10);
	vec3 beta = vec3(0.055, 0.12, 0.26);
	vec3 extinction = exp(-beta * optical_path * (1.0 + u_rough * 1.2));
	vec3 blue_scatter = vec3(0.16, 0.36, 0.70) * rayleigh_phase;
	vec3 daylight = blue_scatter * (1.0 - extinction) * 1.9;
	float horizon = exp(-max(d.y, 0.0) * 8.0);
	daylight += vec3(0.25, 0.31, 0.34) * horizon * (0.65 + u_rough * 0.45);
	float sunset_sector = pow(max(cos_sun, 0.0), 3.0);
	daylight = mix(daylight, daylight * vec3(1.25, 0.75, 0.48),
		u_warm * horizon * sunset_sector * 0.7);
	daylight += sun_col * mie_phase * 0.012 * min(u_sun_e, 2.0)
		* (1.0 - u_rough * 0.75);
	// Thick weather lowers sky radiance as well as the directional sunlight.
	daylight *= mix(1.0, 0.52, u_rough * u_rough);
	// Heavy overcast also removes the blue sky window at the horizon.
	// Keep a diffuse grey source for readable ships beneath the storm deck.
	float overcast = smoothstep(0.42, 1.0, u_rough);
	vec3 overcast_sky = mix(vec3(0.14, 0.18, 0.23), vec3(0.22, 0.25, 0.28), horizon);
	daylight = mix(daylight, overcast_sky, overcast * 0.90);
	vec3 night_color = mix(vec3(0.015, 0.030, 0.065), vec3(0.050, 0.085, 0.14), horizon);
	if (u_web) night_color = sky_linear(night_color);
	vec3 col = mix(daylight, night_color, u_night);
	if (d.y < 0.0) {
		col = mix(col, vec3(0.015, 0.021, 0.023) * (1.0 - u_night * 0.7),
			1.0 - exp(d.y * 7.0));
	}
	// Broad lit cloud layers are sampled at a shared world-space altitude.
	if (d.y > 0.015) {
		vec2 cloud_pos = u_camera.xz + d.xz * max(1800.0 - u_camera.y, 100.0)
			/ max(d.y, 0.035);
		// Filter macro occlusion at the angular footprint instead of thresholding
		// fine noise on very long, grazing sky rays.
		vec2 depth_step = d.xz * 240.0 / max(d.y, 0.06);
		float footprint = max(1800.0 - u_camera.y, 100.0) / max(d.y, 0.035)
			* 0.024064 / (AT_CUBEMAP_PASS ? 128.0 : 900.0);
		float lod = max(log2(max(footprint, 1.0)), 0.0);
		float density = cloud_density_filtered(cloud_pos, lod) * 0.5
			+ cloud_density_filtered(cloud_pos - depth_step, lod) * 0.25
			+ cloud_density_filtered(cloud_pos + depth_step, lod) * 0.25;
		// Retain common macro density for disk occlusion and world cloud shadows.
		// View scattering comes from a finite layer, not a flat painted sheet.
		// Deterministic midpoint integration has no camera/screen-locked dither.
		vec4 volume;
		if (AT_CUBEMAP_PASS) {
			// Reflections need broad cloud energy, not the expensive view march.
			vec3 cloud_light = mix(vec3(0.70, 0.77, 0.84), vec3(0.045, 0.070, 0.11), u_night);
			volume = vec4(cloud_light * mix(1.0, 0.48, u_rough), clamp(density, 0.0, 0.92));
		} else {
			volume = integrate_project_cloud(u_camera, d, sd, sun_col, u_sun_e, u_night, u_rough, mie_phase, 0.5);
		}
		float opacity = volume.a * smoothstep(0.015, 0.09, d.y);
		col = mix(col, volume.rgb, opacity);
		float transmittance = min(1.0 - opacity, exp(-density * 3.0));
		float edge = AT_CUBEMAP_PASS ? 0.004 : 0.0008;
		float sun_disk = 1.0 - smoothstep(0.007 - edge, 0.007 + edge, length(d - sd));
		// Bounded HDR disks participate in the native sky reflection on PC water.
		col += sun_col * sun_disk * min(u_sun_e * 3.0, 5.4)
			* u_sun_visibility * u_disks.x * transmittance;
		vec3 md = normalize(u_moon_dir);
		float moon_disk = 1.0 - smoothstep(0.009 - edge, 0.009 + edge, length(d - md));
		vec3 moon_right = normalize(cross(vec3(0.0, 1.0, 0.0), md));
		vec3 moon_up = cross(md, moon_right);
		vec2 moon_uv = vec2(dot(d, moon_right), dot(d, moon_up)) / 0.009;
		float crater = 0.88 + 0.07 * sin(moon_uv.x * 13.0) * sin(moon_uv.y * 17.0);
		float limb = sqrt(max(1.0 - dot(moon_uv, moon_uv), 0.0));
		vec3 moon_col = vec3(0.62, 0.72, 0.91);
		if (u_web) moon_col = sky_linear(moon_col);
		col += moon_col * moon_disk * crater * (0.55 + limb * 0.45)
			* u_moon_visibility * u_disks.y * transmittance;
		float halo = exp(-pow(length(d - md) / 0.055, 2.0));
		col += moon_col * halo * 0.035 * u_moon_visibility * transmittance;
		// Tiny stars do not alias the coarse reflection cubemap or drive exposure.
		if (u_stars_visibility > 0.01 && !AT_CUBEMAP_PASS) {
			col += star_field(d) * u_stars_visibility * transmittance
				* smoothstep(0.025, 0.18, d.y);
		}
	}
	// Low angular band shares the water's air-scattering colour, including
	// storm and moonlit skies. Blend smoothly on both sides of the horizon.
	if (!u_web) col = mix(col, u_air_color, exp(-abs(d.y) * 10.0));
	if (u_web) {
		// The distant water and sky meet at the same air-scattering colour,
		// on both sides of the horizon, without a separate painted band.
		float air_horizon = exp(-abs(d.y) * 10.0);
		col = mix(col, sky_linear(env_web_fog_color.rgb), air_horizon);
		// GLES sky COLOR is decoded by the engine before fog/tonemapping.
		// The atmosphere above is linear: encode once, like Web water ALBEDO.
		col = max(col, vec3(0.0));
		col = mix(col * 12.92, 1.055 * pow(col, vec3(1.0 / 2.4)) - 0.055,
			step(vec3(0.0031308), col));
	}
	COLOR = max(col, vec3(0.0));
	if (u_cloud_probe == 1) COLOR = vec3(textureLod(u_cloud_noise_tex, vec2(atan(d.x, d.z) / 6.2831853 + 0.5, d.y * 2.0), 0.0).r);
	if (u_cloud_probe == 2) COLOR = vec3(textureLod(u_cloud_volume_tex, vec3(atan(d.x, d.z) / 6.2831853 + 0.5, d.y * 2.0, 0.5), 0.0).r);
	if (u_cloud_probe == 3) COLOR = vec3(cloud_density(u_camera.xz + d.xz * 1800.0 / max(d.y, 0.035)));
}
