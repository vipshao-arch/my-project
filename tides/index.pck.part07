ãÖÁœ™<|V§Zâ¤µwŒYÚ7Ì%éw?Oˆ·Á_¢ŠÁÜLñô uó•CG±=½_	Ì:lÞ␀␀␀␀␀␀␀␀␀␀␀␀// Direct GGX lighting. Environment radiance and air fog stay in the engine.
void light() {
	float nl = max(dot(NORMAL, LIGHT), 0.0);
	float nv = max(dot(NORMAL, VIEW), 0.001);
	vec3 halfway = normalize(LIGHT + VIEW);
	float nh = max(dot(NORMAL, halfway), 0.0);
	float vh = max(dot(VIEW, halfway), 0.0);
	float a = max(ROUGHNESS * ROUGHNESS, 0.035);
	float a2 = a * a;
	float divisor = nh * nh * (a2 - 1.0) + 1.0;
	float distribution = a2 / (3.14159265 * divisor * divisor);
	float k = (ROUGHNESS + 1.0) * (ROUGHNESS + 1.0) * 0.125;
	float visibility = nv / (nv * (1.0 - k) + k)
		* nl / (nl * (1.0 - k) + k);
	vec3 f0 = mix(vec3(0.04), ALBEDO, METALLIC);
	vec3 fresnel = f0 + (1.0 - f0) * pow(1.0 - vh, 5.0);
	float cloud = LIGHT_IS_DIRECTIONAL ? cloud_transmittance(v_world) : 1.0;
	vec3 energy = LIGHT_COLOR * ATTENUATION * cloud;
	// Reflected specular energy is unavailable to diffuse transmission.
	DIFFUSE_LIGHT += nl * energy * (vec3(1.0) - fresnel) * (1.0 - METALLIC) / 3.14159265;
	SPECULAR_LIGHT += distribution * visibility * fresnel
		/ max(4.0 * nv * nl, 0.001) * nl * energy * SPECULAR_AMOUNT;
}
