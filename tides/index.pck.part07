~␀␀␀␀␀shader_type spatial;
uniform float time=0.0;
varying vec3 wp;
void vertex(){wp=(MODEL_MATRIX*vec4(VERTEX,1.0)).xyz;VERTEX.y+=sin(dot(wp.xz,vec2(.031,.012))+time*.26)*.35+sin(dot(wp.xz,vec2(-.011,.043))-time*.21)*.20;}
void fragment(){
	float a=dot(wp.xz,vec2(.031,.012))+time*.26;
	float b=dot(wp.xz,vec2(-.011,.043))-time*.21;
	vec2 gradient=cos(a)*.35*vec2(.031,.012)+cos(b)*.20*vec2(-.011,.043);
	gradient+=cos(dot(wp.xz,vec2(.29,.16))+time*.43)*.028*vec2(.29,.16);
	gradient+=cos(dot(wp.xz,vec2(-.19,.39))-time*.37)*.016*vec2(-.19,.39);
	ALBEDO=vec3(.018,.16,.20);ROUGHNESS=.19;SPECULAR=.65;
	NORMAL=normalize((VIEW_MATRIX*vec4(normalize(vec3(-gradient.x,1.0,-gradient.y)),0.0)).xyz);
}
