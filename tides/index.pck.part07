global uniform float env_wind_strength;
global uniform float env_wind_rough;
global uniform float env_wind_clock;
global uniform vec2 env_wind_offset;
global uniform vec2 env_wind_lengths;
global uniform vec4 env_wind_flex;

// xy = local direction; z = local gust pressure. Mirrors wind_field.gd.
vec3 visual_wind(vec2 p) {
	vec2 across = vec2(-env_wind_dir.y, env_wind_dir.x);
	vec2 q = p - env_wind_offset;
	float phase = dot(q, env_wind_dir) * 6.2831853 / env_wind_lengths.x
		+ sin(dot(q, across) * 6.2831853 / env_wind_lengths.y) * 1.3;
	float front = pow(0.5 + 0.5 * sin(phase), 3.0);
	float broad = 0.5 + 0.5 * sin(dot(q, vec2(0.006, 0.010)) + env_wind_clock * 0.10);
	float turn = sin(dot(p, vec2(0.008, 0.013)) + env_wind_clock * 0.28) * mix(0.08, 0.18, env_wind_rough);
	return vec3(normalize(env_wind_dir + across * turn), env_wind_strength * (0.48 + 0.55 * front + 0.12 * broad));
}
␀␀␀␀␀␀␀␀␀␀␀␀␀␀#include "res://td3d/environment/wind_field.gdshaderinc"
// 0 rigid, 1 foliage (bottom fixed), 2 sail (top fixed), 3 flag (hoist fixed).
uniform int u_wind_mode = 0;
uniform vec4 u_wind_bounds = vec4(0.0, 1.0, 0.0, 1.0); // min y, height, min z, depth

vec3 wind_deform(vec3 vertex, mat4 model) {
	if (u_wind_mode == 0) return vertex;
	vec3 origin = model[3].xyz;
	vec3 wind = visual_wind(origin.xz);
	vec3 flow = vec3(wind.x, 0.0, wind.y);
	float phase = dot(origin.xz, vec2(0.019, 0.037));
	float h = max(u_wind_bounds.y, 0.01);
	float height = h * length(model[1].xyz);
	vec3 delta = vec3(0.0);
	if (u_wind_mode == 1) {
		float root = smoothstep(0.10, 0.98, (vertex.y - u_wind_bounds.x) / h);
		// World height includes the species/instance scale (also in MultiMesh).
		// Tall trunks respond over tens of seconds; grass responds sooner.
		// Two slow, non-harmonic components avoid a metronomic whole-tree wobble.
		float inertia = smoothstep(1.0, 16.0, height);
		float bend_rate = mix(0.70, 0.18, inertia);
		float flutter_rate = mix(1.65, 0.45, inertia);
		float drift = 0.78 + 0.16 * sin(env_wind_clock * bend_rate + phase)
			+ 0.06 * sin(env_wind_clock * bend_rate * 0.43 + phase * 1.73);
		float bend = min(height * env_wind_flex.x, 2.5) * root * root * wind.z
			* drift;
		float flutter = min(height * env_wind_flex.y, 0.35) * root * wind.z
			* (0.72 * sin(env_wind_clock * flutter_rate + dot(vertex, vec3(1.8, 2.1, 1.4)) + phase)
			+ 0.28 * sin(env_wind_clock * flutter_rate * 0.57 + phase * 2.31));
		delta = flow * bend + vec3(-flow.z, 0.0, flow.x) * flutter;
	} else if (u_wind_mode == 2) {
		float root = clamp((u_wind_bounds.x + h - vertex.y) / h, 0.0, 1.0);
		float flutter = sin(env_wind_clock * 4.6 - root * 7.0 + phase);
		delta = flow * min(height * env_wind_flex.z, 0.60) * wind.z * root * root * (0.65 + flutter * 0.35);
	} else if (u_wind_mode == 3) {
		float width = max(u_wind_bounds.w, 0.01);
		float root = clamp((u_wind_bounds.z + width - vertex.z) / width, 0.0, 1.0);
		float wave = sin(env_wind_clock * 5.0 - root * 7.0 + phase)
			+ 0.35 * sin(env_wind_clock * 3.1 - root * 11.0 + phase);
		float size = width * length(model[2].xyz);
		delta = normalize(model[0].xyz) * wave * size * env_wind_flex.w * root * root * wind.z;
		delta.y += wave * size * 0.028 * root * wind.z;
	}
	return vertex + inverse(mat3(model)) * delta;
}
