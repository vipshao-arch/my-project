f´|Î…C‚þIoxw´'ìŽ¸žÞüt¹Bëõ§ehß¾Sì†Ý6·tú4ßõÚõÀN†öKítÎÍ#ãgƒ†D^ÏüÒ¿ŽÒøHÜ;Â}ÐËÈŠÐ}›/²<}Š3ãÌ¤Îåì£º¤ÒKbñÚðvì›j¼}i½s:»QnºL´®lžcå/ú¹ÛíÏçnFËC»␀…wál&1ùöÙ*¾ä¹_\—à¸IË„Nr^’QÉ#l²×~TÀƒØÃí	wµ­37âÒ:®«|±hÊ½˜Oìÿa•zÔ~ru1‚»Ÿ-Úƒö*Å{vÇ‹p5€~í	ï»ðOÔ"ÌcÏ‡{ŒâGÙ³þPmzŽŸêQ½>Ý}cë+Ø†²&ÈÒŸ_7?7ûò{Ñ3gø%ïoHû„ó•[?~KønÄ29ÂÆ/‹·ÍýEÅi£¬Nû¶ï}ÿ¸ýn~øôìãúþ]Ìá{ý?mZƒñfÚŠËAo”½Pú~««ÿ”íÜnÉ‰IæV␀␀shader_type spatial;
render_mode diffuse_burley, specular_schlick_ggx, cull_disabled;
varying vec3 world_pos;
float sand_hash(vec2 p) {
	return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
}
float sand_noise(vec2 p) {
	vec2 cell = floor(p);
	vec2 f = fract(p);
	f = f * f * (3.0 - 2.0 * f);
	return mix(mix(sand_hash(cell), sand_hash(cell + vec2(1.0, 0.0)), f.x),
		mix(sand_hash(cell + vec2(0.0, 1.0)), sand_hash(cell + vec2(1.0)), f.x), f.y);
}
void vertex() { world_pos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz; }
void fragment() {
	// Restrained mineral patches; no parallel dune lines or new texture layers.
	vec2 p = world_pos.xz;
	float mineral = sand_noise(p * 0.042 + vec2(19.0, 41.0));
	float grain = sand_noise(vec2(p.x * 0.29 - p.y * 0.19, p.x * 0.19 + p.y * 0.29));
	float grain_fade = 1.0 - smoothstep(0.3, 1.2, length(fwidth(p)));
	ALBEDO = COLOR.rgb * (0.95 + mineral * 0.10 + (grain - 0.5) * grain_fade * 0.035);
	ROUGHNESS = 0.95;
}
