ªÇ…!ã®1£þ‡ÛqŸ6ãC›3róÿ^Ý›X¿Ds~ñ(èón:W¦ÛÅ“¬'a÷8„Hx”R¹ÐÈµAÖÓx+õþ=^èí×zŸ<2<Ù®àØn®<çï¬Ûñ¾ÊËøDÿ/xÏv=|ýÜú—rôØfÏ°ø#È\ãºÛK=ËÜàEowïVÎEqú¹\:nYÅtÓý¸_²2&{Rìoù»ù Ü«‚ìIÍá-ÇVw>¯XñùH§1Û@ôyuþõU„wŽ´ôŸ<Ñ½Ž¥¸»w‚NÉçyøÁì^›¬²òHKâÊ]4dV;<þÚ9Ï£é1>ïé:Ø€Ûc€<ëq“/Žy*®XËK‚Ö…-␀ï
␀␀shader_type spatial;
render_mode unshaded, cull_disabled, depth_draw_never;

uniform sampler2D u_streak : filter_linear, repeat_disable;
uniform vec3 u_drop_direction = vec3(0.1, -1.0, 0.0);
varying float v_distance;

void vertex() {
	vec3 center = (VIEW_MATRIX * MODEL_MATRIX * vec4(0.0, 0.0, 0.0, 1.0)).xyz;
	v_distance = length(center);
	vec2 direction = (VIEW_MATRIX * vec4(u_drop_direction, 0.0)).xy;
	direction /= max(length(direction), 0.001);
	vec2 right = vec2(direction.y, -direction.x);
	float sx = length(MODEL_MATRIX[0].xyz);
	float sy = length(MODEL_MATRIX[1].xyz);
	vec2 offset = right * VERTEX.x * sx - direction * VERTEX.y * sy;
	POSITION = PROJECTION_MATRIX * vec4(center + vec3(offset, 0.0), 1.0);
}

void fragment() {
	ALBEDO = vec3(0.64, 0.76, 0.84);
	ALPHA = texture(u_streak, UV).a * COLOR.a * 0.25
		* smoothstep(12.0, 35.0, v_distance)
		* (1.0 - smoothstep(850.0, 1250.0, v_distance));
}
␀␀␀␀␀␀␀␀␀␀␀␀␀␀GDSCe␀␀␀ì␀␀(µ/ý`ìE␀F75PÅ&Ã`™¶DáU§8ÝâßÎÝ+ÕWƒgVp{™uÆý{Aê¼ónŒ8ö^b÷&„²S"␀*␀*␀O™´õhÒ–$³iÛAùH[¶mEÚjÚ~´9üîˆ␀…‰ÅìÉ‘`yš…@/”ÁøJþ€¿ò|~ÒŒ:ÚŽ~«íè–õ¬˜@’Ü0	yÁcŒ±…á?ø¯ß àø+¿dqpÆl4<0|N,|8”R|1^Ó=YÂ6Ý%­W½GMW‘ÒuMÓ5Ù‘<lr¬ÖZ«Z›¨€Î¨±Ý›¤Ôvð‘!ê hXZ%f”Ô§2ÊBÐã×lßÿ,üwVtj¥I;Há#'ÔÐÂ¨Ùþ‡Œ?½Q††—
nÅ}à&F¨ÔSbÙàÊø~ÃC3°Ø„¨Ôc*][V–ßÇóØ 0™·ØRX†eº_ÒÉúƒÀ-¹oýäæÈWâmpŸ[™”Ç‡§;|èÆ™Zê␀FÛO|Zs‹Ç—[ß“Jª2ÄqõE§Ø&ó¾ÀO¹|Ó¾m¯94±èi,öM/x‰Ñ}Þº½"ïC`^ï7ÜÐ!ÌÕ³éa¯WÑúõÆa1úŽ×et0–ý‹í3ÜgÿÐ¼<ç“©…V»f5␀␀shader_type spatial;
render_mode blend_mix, depth_draw_never, cull_disabled, unshaded, shadows_disabled, ambient_light_disabled, fog_disabled;

uniform vec4 u_col : source_color = vec4(1.0, 0.80, 0.34, 1.0);
uniform float u_time = 0.0;
uniform float u_flow_time = 0.0;
uniform float u_wave_height = 1.0;
uniform float u_wave_dir = 0.0;
uniform float u_rough = 0.0;
uniform sampler2DArray u_coast_tex : filter_linear, repeat_disable;
uniform vec4 u_coast_bounds[32];
uniform int u_coast_n = 0;
uniform float u_lift = 0.38;

#include "res://td3d/ocean_waves.gdshaderinc"
#include "res://td3d/coast_sampling.gdshaderinc"

varying vec2 v_uv;

void vertex() {
	v_uv = UV;
	vec3 wp = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
	vec2 gradient;
	float height = ocean_height(wp.xz, u_time, gradient);
	float shore = smoothstep(0.0, 38.0, coast_at(wp.xz).x);
	VERTEX.y += height * shore + u_lift;
}

void fragment() {
	float u = v_uv.x;
	float v = v_uv.y;

	// å…‰å¸¦æœ¬ä½“ï¼šä¸­é—´å®žã€ä¸¤ä¾§æŸ”å’Œæ”¶è¾¹
	float edge = smoothstep(0.0, 0.20, u) * (1.0 - smoothstep(0.80, 1.0, u));
	float lane = edge * 0.045;

	// æµåŠ¨è™šçº¿ï¼šæ²¿èˆªçº¿å‘å‰æŽ¨è¿›
	float dash = fract(v * 0.90 - u_flow_time * 0.55);
	float dm = smoothstep(0.00, 0.07, dash) * (1.0 - smoothstep(0.34, 0.44, dash));
	float mid = 1.0 - smoothstep(0.05, 0.19, abs(u - 0.5));
	float core = mid * dm;

	// ä¸¤ä¾§å¯¼è½¨
	float rail = 1.0 - smoothstep(0.015, 0.055, abs(abs(u - 0.5) - 0.42));
	rail *= edge;

	// ç»†ç¢Žæ°´å…‰ï¼Œé¿å…æ•´æ¡å¸¦å­åƒè´´çº¸
	float grain = 0.82 + 0.18 * sin(v * 5.3 - u_flow_time * 2.1 + u * 11.0);
	float a = (lane + core * 0.95 + rail * 0.14) * grain;
	a *= 0.90 + 0.10 * sin(u_flow_time * 1.3);

	ALBEDO = u_col.rgb;
	ALPHA = clamp(a, 0.0, 1.0) * u_col.a;
}
␀␀// Visible fragments follow individual physical crests, not the summed height.
// Kept on the opaque water surface so no detached foam plane is introduced.
uniform sampler2D u_naval_foam : filter_linear_mipmap, repeat_enable;

// Naval Battle Kit Foam.hlsl's RGBA micro/temporal/noise/macro erosion,
// with softer alpha transitions and filtered subpixel pores for this camera.
float sea_naval_erosion(vec4 masks, float coverage) {
	float age = pow(1.0 - clamp(coverage, 0.0, 1.0) * 0.65, 4.0);
	age += (1.0 - 2.0 * masks.r) * mix(0.05, 0.60, age);
	age -= (2.0 * masks.g - 1.0) * mix(0.10, 0.20, age);
	age = clamp(age * 2.2, 0.0, 1.0);
	float aa = max(fwidth(masks.a), 0.025);
	float alpha = smoothstep(age - aa, age + max(0.12, aa * 2.0), masks.a);
	float pore_alpha = 1.0 - mix(masks.a, masks.r, 0.5) * 0.45;
	float grain = pow(max(masks.b, 0.001), 0.3);
	return alpha * pore_alpha * grain * pow(1.0 - age, 2.0)
		+ pow(coverage * 0.8, 5.0) * 0.35;
}

float sea_breaker_foam(vec2 p, float t, vec4 breaking, float lace) {
	vec3 wind = visual_wind(p);
	// Integrate displacement instead of multiplying a changing direction by
	// total runtime; the latter accelerates/slides the whole pattern late in a run.
	vec2 drifting = p - env_wind_offset * 0.056;
	float broad = foam_noise(drifting * 0.004 + vec2(41.0, 17.0));
	// foam_noise internally scales by .11. These frequencies make short
	// local gaps (tens of metres), instead of hundred-metre white stretches.
	float patch = foam_noise(drifting * 0.29 + vec2(9.4, 53.1));
	float width_field = foam_noise(drifting * 0.18 + vec2(73.3, 6.2));
	float rim = foam_noise(drifting * 0.61 + vec2(12.7, 48.1));
	float weather_density = mix(0.72, 1.0, u_rough);
	float macro_active = mix(0.72, 1.0, smoothstep(0.30, 0.65, broad));
	// Smaller variable widths, with Gaussian falloff and a porous fringe.
	float width = mix(0.006, 0.026, smoothstep(0.25, 0.72, width_field))
		* mix(0.60, 1.15, rim);
	float gust = clamp(0.65 + wind.z * 0.65, 0.65, 1.45);
	vec2 uv = drifting * 0.11;
	vec2 rotated = vec2(uv.x * 0.80 - uv.y * 0.60, uv.x * 0.60 + uv.y * 0.80);
	vec4 mask0 = texture(u_naval_foam, uv);
	vec4 mask1 = texture(u_naval_foam, rotated * 1.37 + vec2(0.31, 0.73));
	float foam = 0.0;
	for (int i = 0; i < 4; i++) {
		float smaller = pow(0.68, float(i));
		float aa = max(fwidth(breaking[i]), 0.002);
		float crest_distance = max(1.0 - breaking[i], 0.0);
		float core = exp(-crest_distance / (width * smaller + aa * 0.45));
		// Spatial activity goes BEFORE erosion: otherwise even a weak gate
		// leaves continuous crossing lines visible all along the wave crest.
		float local_patch = smoothstep(0.48, 0.72, patch);
		if (i == 1) local_patch = smoothstep(0.47, 0.70, width_field);
		if (i == 2) local_patch = smoothstep(0.47, 0.70, rim);
		if (i == 3) local_patch = smoothstep(0.46, 0.68, (patch + rim) * 0.5);
		local_patch *= macro_active;
		float pores = sea_naval_erosion(mask0, core * local_patch) * 0.65
			+ sea_naval_erosion(mask1, core * local_patch) * 0.35;
		float fringe = exp(-crest_distance / (width * smaller * 2.2 + aa))
			* lace * 0.025 * pow(local_patch, 5.0);
		foam = max(foam, (pores * 0.68 + fringe)
			* mix(1.0, 0.58, float(i) / 3.0));
	}
	return foam * (0.30 + u_rough * 0.46) * gust * weather_density;
}
␀␀␀␀␀␀␀␀␀␀␀␀␀shader_type fog;
uniform float u_density = 0.0005;
uniform vec2 u_drift = vec2(0.0);
#include "res://td3d/environment/wind_field.gdshaderinc"

float mist_hash(vec3 p) {
	return fract(sin(dot(p, vec3(127.1, 311.7, 74.7))) * 43758.5453);
}
float mist_noise(vec3 p) {
	vec3 i = floor(p);
	vec3 f = fract(p);
	f = f * f * (3.0 - 2.0 * f);
	return mix(mix(mix(mist_hash(i), mist_hash(i + vec3(1,0,0)), f.x),
		mix(mist_hash(i + vec3(0,1,0)), mist_hash(i + vec3(1,1,0)), f.x), f.y),
		mix(mix(mist_hash(i + vec3(0,0,1)), mist_hash(i + vec3(1,0,1)), f.x),
		mix(mist_hash(i + vec3(0,1,1)), mist_hash(i + vec3(1,1,1)), f.x), f.y), f.z);
}
void fog() {
	vec3 p = WORLD_POSITION;
	float patch = smoothstep(0.30, 0.78,
		mist_noise(vec3((p.xz - u_drift) * 0.004, p.y * 0.035)));
	vec3 wind = visual_wind(p.xz);
	vec2 q = p.xz - u_drift;
	vec2 across = vec2(-env_wind_dir.y, env_wind_dir.x);
	float ribbons = mist_noise(vec3(dot(q,env_wind_dir)*0.008,
		dot(q,across)*0.060,p.y*0.12+env_wind_clock*0.013));
	patch *= mix(0.65,1.35,smoothstep(0.25,0.75,ribbons));
	float height = exp(-max(p.y, 0.0) / 15.0) * smoothstep(-5.0, 0.0, p.y);
	float edges = smoothstep(0.0, 0.20, min(min(UVW.x, 1.0 - UVW.x),
		min(UVW.z, 1.0 - UVW.z)));
	DENSITY = u_density * height * (0.15 + patch * 0.85) * edges * (0.82+wind.z*.25);
	ALBEDO = vec3(0.92, 0.96, 1.0);
	EMISSION = vec3(0.0);
}
